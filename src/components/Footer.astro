---
import { url } from '../lib/url';
import { site } from '../site';
import Logo from './Logo.astro';

const groups = [
  {
    title: 'Courses',
    links: [
      ['/ap-micro/', 'AP Microeconomics'],
      ['/ap-macro/', 'AP Macroeconomics'],
      ['/learn/', 'All lessons'],
      ['/glossary/', 'Glossary'],
    ],
  },
  {
    title: 'Practice',
    links: [
      ['/practice/', 'Question bank'],
      ['/frq/', 'Free-response questions'],
      ['/flashcards/', 'Flashcards'],
      ['/graph-lab/', 'Graph lab'],
      ['/score-calculator/', 'Score calculator'],
      ['/mock-exam/', 'Mock exam (Pro)'],
      ['/review/', 'Review sheets (Pro)'],
    ],
  },
  {
    title: 'Site',
    links: [
      ['/about/', 'About'],
      ['/pricing/', 'Pricing'],
      ['/account/', 'Your data and settings'],
      ['/privacy/', 'Privacy policy'],
      ['/cookies/', 'Cookie policy'],
      ['/terms/', 'Terms of use'],
      ['/refunds/', 'Refund policy'],
      ['/accessibility/', 'Accessibility'],
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href={url('/')}>
          <Logo size={30} />
          <span>{site.name}</span>
        </a>
        <p class="note">
          Free review for AP Microeconomics and AP Macroeconomics, organized by the official course topics. No account, no ads, no tracking.
        </p>
        <p class="note">Found a mistake in a lesson or question? <a href={site.contactUrl}>Tell us on GitHub</a>.</p>
      </div>
      {groups.map((g) => (
        <nav aria-label={g.title} class="group">
          <h2 class="group-title">{g.title}</h2>
          <ul>
            {g.links.map(([href, label]) => (
              <li><a href={url(href)}>{label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="bottom">
      <p>AP is a trademark registered by the College Board, which is not affiliated with, and does not endorse, this site.</p>
      <p>&copy; {year} <a href={site.ownerUrl}>{site.owner}</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: 3.5rem 2rem;
    font-size: 0.95rem;
    background: var(--bg-2);
    border-top: 1px solid var(--line);
  }
  .top {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 860px) {
    .top {
      grid-template-columns: 1.6fr repeat(3, 1fr);
    }
  }
  .about {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    max-width: 38ch;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    text-decoration: none;
    justify-self: start;
  }
  .note {
    color: var(--ink-2);
  }
  .group-title {
    font-family: var(--font-text);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink);
    margin-bottom: 0.6rem;
  }
  .group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.05rem;
  }
  .group a {
    display: inline-block;
    padding-block: 0.25rem;
    text-decoration: none;
    color: var(--ink-2);
  }
  .group a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.87rem;
  }
  .bottom p:first-child {
    max-width: 64ch;
  }
</style>
