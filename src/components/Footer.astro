---
import { url } from '../lib/url';
import { site } from '../site';
import Logo from './Logo.astro';

const groups = [
  {
    title: 'Study',
    links: [
      ['/learn/', 'All units'],
      ['/practice/', 'Practice questions'],
      ['/graph-lab/', 'Graph lab'],
      ['/glossary/', 'Glossary'],
      ['/mock-exam/', 'Mock exam (Pro)'],
      ['/review/', 'Review sheets (Pro)'],
    ],
  },
  {
    title: 'Site',
    links: [
      ['/about/', 'About'],
      ['/pricing/', 'Pricing'],
      ['/account/', 'Your data and settings'],
    ],
  },
  {
    title: 'Policies',
    links: [
      ['/privacy/', 'Privacy policy'],
      ['/cookies/', 'Cookie policy'],
      ['/terms/', 'Terms of use'],
      ['/refunds/', 'Refund policy'],
      ['/accessibility/', 'Accessibility'],
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="site-footer on-board">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href={url('/')}>
          <Logo size={30} />
          <span>{site.name}</span>
        </a>
        <p class="sign">Economics you can move.</p>
        <p class="note">
          Free lessons for AP Microeconomics and AP Macroeconomics. No account, no ads, no tracking.
          Found a mistake? <a href={site.contactUrl}>Tell us on GitHub</a>.
        </p>
      </div>
      {groups.map((g) => (
        <nav aria-label={g.title} class="group">
          <h2 class="group-title">{g.title}</h2>
          <ul>
            {g.links.map(([href, label]) => (
              <li><a href={url(href)}>{label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="bottom">
      <p>AP is a trademark registered by the College Board, which is not affiliated with, and does not endorse, this site.</p>
      <p>&copy; {year} <a href={site.ownerUrl}>{site.owner}</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background-color: var(--board-deep);
    padding-block: 4rem 2rem;
    font-size: 0.97rem;
  }
  .top {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 820px) {
    .top {
      grid-template-columns: 1.7fr repeat(3, 1fr);
    }
  }
  .about {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    max-width: 36ch;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-decoration: none;
    justify-self: start;
  }
  .sign {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1.1;
    color: var(--chalk);
  }
  .note {
    color: var(--chalk-2);
    font-size: 0.95rem;
  }
  .group-title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--chalk-3);
    margin-bottom: 0.7rem;
  }
  .group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.1rem;
  }
  .group a {
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration: none;
    color: var(--chalk);
  }
  .group a:hover {
    text-decoration: underline;
    text-decoration-color: var(--hl);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(243, 246, 240, 0.14);
    color: var(--chalk-2);
    font-size: 0.87rem;
  }
  .bottom p:first-child {
    max-width: 64ch;
  }
</style>
