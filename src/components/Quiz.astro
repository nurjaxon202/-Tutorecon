---
import type { Question } from '../data/questions';
import { getUnit } from '../data/units';
import { topicById } from '../data/ced';
import { uniqueSvg } from '../data/questions/figures';
import { gated } from '../lib/access';
import { url } from '../lib/url';

interface Props {
  questions: Question[];
  /** Where to save the score. Use a unit slug, or 'mixed'. */
  saveAs: string;
  title?: string;
  intro?: string;
  /** Show a random set of this many questions, with a course filter. */
  sample?: number;
  headingLevel?: 'h2' | 'h3';
  /** Show "Question 1 of 6" labels. */
  numbered?: boolean;
  eyebrow?: string;
  /** This quiz is a unit's own check: finishing it marks the unit done. */
  unitCheck?: boolean;
  /** Guests see only this many questions; the rest come with a free account. */
  preview?: number;
}
const {
  questions,
  saveAs,
  title = 'Check your understanding',
  intro = 'Pick an answer, then check it. Every choice has its own explanation, so a wrong answer still teaches you something.',
  sample,
  headingLevel = 'h2',
  numbered = true,
  eyebrow = 'Practice',
  unitCheck = false,
  preview,
} = Astro.props;
const locked = gated && preview && questions.length > preview ? questions.length - preview : 0;
const Heading = headingLevel;
const letters = ['A', 'B', 'C', 'D', 'E'];
const data = Object.fromEntries(
  questions.map((q) => [q.id, { answer: q.answer, why: q.options.map((o) => o.why), unit: q.unit }]),
);
const id = `quiz-${saveAs}`;
---
<section class="quiz" data-quiz data-save={saveAs} data-sample={sample} data-unit-check={unitCheck ? 'true' : undefined} data-preview={locked ? preview : undefined} aria-labelledby={`${id}-title`}>
  <div class="quiz-head">
    <p class="eyebrow">{eyebrow}</p>
    <Heading id={`${id}-title`} class="h2">{title}</Heading>
    <p class="muted">{intro}</p>
    <p class="quiz-best mono" data-best hidden></p>
  </div>

  <div class="quiz-meta">
    {questions.length > 1 && (
      <ol class="quiz-strip" aria-hidden="true" data-strip>
        {questions.map((q, i) => <li data-strip-q={q.id} data-over-preview={locked && i >= preview! ? '' : undefined}></li>)}
      </ol>
    )}
    <p class="quiz-keys">Keyboard: <kbd>A</kbd> to <kbd>E</kbd> to choose, <kbd>Enter</kbd> to check</p>
  </div>

  {sample && (
    <div class="quiz-filter">
      <fieldset class="ctl-choice">
        <legend>Questions from</legend>
        <div class="seg">
          <label><input type="radio" name={`${id}-course`} value="all" checked data-course /><span>All units</span></label>
          <label><input type="radio" name={`${id}-course`} value="micro" data-course /><span>AP Micro</span></label>
          <label><input type="radio" name={`${id}-course`} value="macro" data-course /><span>AP Macro</span></label>
        </div>
      </fieldset>
      <button type="button" class="btn btn-secondary btn-small" data-new-set>New set of questions</button>
    </div>
  )}

  <ol class="quiz-list">
    {questions.map((q, i) => {
      const unit = getUnit(q.unit);
      return (
        <li class="qcard" data-q={q.id} data-course={unit?.course} data-over-preview={locked && i >= preview! ? '' : undefined}>
          <fieldset>
            <legend>
              {numbered && (
                <span class="q-n" data-qn-row>
                  <span data-qn>Question {i + 1} of {questions.length}</span>
                  {q.topics.slice(0, 1).map((t) => topicById.get(t) && <span class="q-topic">Topic {topicById.get(t)!.code}</span>)}
                </span>
              )}
              {sample && unit && <span class="q-unit mono">{unit.title}</span>}
              <span class="q-prompt">{q.prompt}</span>
            </legend>
            {q.figure && (
              <figure class="q-fig">
                <svg viewBox={`0 0 ${q.figure.w} ${q.figure.h}`} width={q.figure.w} height={q.figure.h} role="img" aria-label={q.figure.alt} focusable="false" set:html={uniqueSvg(q.figure, q.id)} />
              </figure>
            )}
            {q.table && (
              <div class="q-table">
                <table>
                  <thead><tr>{q.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                  <tbody>{q.table.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
                </table>
              </div>
            )}
            <div class="q-options">
              {q.options.map((o, j) => (
                <label class="q-opt" data-opt={j}>
                  <input type="radio" name={`${id}-${q.id}`} value={j} />
                  <span class="q-letter mono" aria-hidden="true">{letters[j]}</span>
                  <span class="q-text">{o.text}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div class="q-actions">
            <button type="button" class="btn btn-small" data-check>Check answer</button>
          </div>
          <div class="q-feedback" data-feedback aria-live="polite"></div>
        </li>
      );
    })}
  </ol>

  {locked > 0 && (
    <div class="quiz-more" data-guest-only>
      <p><strong>{locked} more question{locked === 1 ? '' : 's'} on this topic</strong> come with a free account, along with the full question bank, smart review of the questions you miss, and your progress on every device.</p>
      <div class="btn-row">
        <a class="btn btn-small" href={url('/sign-up/')}>Create a free account</a>
        <a class="btn btn-secondary btn-small" href={url(`/sign-in/?next=${encodeURIComponent(Astro.url.pathname + '#practice')}`)}>Sign in</a>
      </div>
    </div>
  )}

  <div class="quiz-score" data-score aria-live="polite" hidden></div>
  <script type="application/json" data-quiz-data set:html={JSON.stringify(data)} />
</section>

<script>
  import '../scripts/quiz';
</script>
