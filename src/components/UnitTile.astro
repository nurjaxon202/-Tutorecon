---
import GraphThumb from './GraphThumb.astro';
import { unitThumb } from '../data/thumbs';
import { unitLabel, type Unit } from '../data/units';
import { url } from '../lib/url';

interface Props {
  unit: Unit;
  meta?: string;
  wide?: boolean;
  /** Show the one-line summary on regular tiles too. */
  summary?: boolean;
}
const { unit, meta, wide = false, summary = false } = Astro.props;
const thumb = unitThumb[unit.slug];
---
<a class:list={['tile', 'on-board', { wide }]} href={url(`/learn/${unit.slug}/`)} data-unit={unit.slug}>
  <span class="tile-art">
    <GraphThumb model={thumb.model} state={thumb.state} width={320} height={210} />
  </span>
  <span class="tile-body">
    <span class="tile-top">
      <span class="tile-n">{unit.apUnit}</span>
      <span class="tile-status mono" data-status></span>
    </span>
    <span class="tile-label mono">{unitLabel(unit)}</span>
    <span class="tile-title">{unit.title}</span>
    {(wide || summary) && <span class="tile-sum">{unit.summary}</span>}
    {meta && <span class="tile-meta mono">{meta}</span>}
  </span>
</a>

<style>
  .tile {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    border: 1px solid rgba(243, 246, 240, 0.1);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    height: 100%;
  }
  .tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 40px -24px rgba(11, 42, 33, 0.8);
  }
  .tile:hover .tile-title {
    text-decoration: underline;
    text-decoration-color: var(--hl);
    text-decoration-thickness: 2px;
  }
  .tile-art {
    display: block;
    padding: 0.9rem 0.9rem 0;
    background-image:
      linear-gradient(rgba(243, 246, 240, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(243, 246, 240, 0.05) 1px, transparent 1px);
    background-size: 18px 18px;
  }
  .tile-art :global(.g-grid),
  .tile-art :global(.g-grid-major),
  .tile-art :global(.g-note),
  .tile-art :global(.g-area-label) {
    display: none;
  }
  .tile-body {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 0.9rem 1.05rem 1.15rem;
  }
  .tile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tile-n {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1;
    color: var(--hl);
  }
  .tile-status:not(:empty) {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: rgba(127, 224, 181, 0.08);
    color: #8ff0c6;
  }
  .tile-label {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--chalk-3);
  }
  .tile-title {
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.25;
    color: var(--chalk);
  }
  .tile-sum {
    color: var(--chalk-2);
    margin-top: 0.2rem;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .tile-meta {
    margin-top: 0.35rem;
    font-size: 0.74rem;
    color: var(--chalk-3);
  }
  .wide {
    grid-template-rows: none;
  }
  @media (min-width: 760px) {
    .wide {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: center;
    }
    .wide .tile-art {
      padding: 1.2rem;
    }
    .wide .tile-body {
      padding: 1.5rem 1.75rem;
    }
    .wide .tile-title {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 1.9rem;
    }
    .wide .tile-n {
      font-size: 3rem;
    }
  }
</style>

<script>
  import '../scripts/tiles';
</script>
