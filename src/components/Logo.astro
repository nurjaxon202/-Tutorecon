  <rect width="32" height="32" rx="9" fill="#1a56f0" />
  <path d="M8.5 6.5v17h17" fill="none" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M11.5 9.5l12.5 11" stroke="#bcd0ff" stroke-width="2.8" stroke-linecap="round" />
  <path d="M11.5 20.5l12.5-11" stroke="#ff9b57" stroke-width="2.8" stroke-linecap="round" />
  <circle cx="17.75" cy="15" r="3" fill="#ffc53d" stroke="#1a56f0" stroke-width="1.2" />
</svg>
