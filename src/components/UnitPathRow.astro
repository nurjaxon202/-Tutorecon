---
// Unit 1, then the path forks into AP Micro and AP Macro.
import { units } from '../data/units';
import { shortTitle } from '../data/short';
import { url } from '../lib/url';

const first = units.find((u) => u.course === 'both')!;
const tracks = [
  { name: 'AP Micro', cls: 'micro', list: units.filter((u) => u.course === 'micro') },
  { name: 'AP Macro', cls: 'macro', list: units.filter((u) => u.course === 'macro') },
];
const check = '<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M6 12.5l4 4L18 8" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<div class="fork">
  <div class="fork-start">
    <a class="node node-both" href={url(`/learn/${first.slug}/`)} data-path-node={first.slug} data-path-track="main">
      <span class="node-circle"><span class="node-n">{first.apUnit}</span><span class="node-check" set:html={check} /></span>
      <span class="node-name">{shortTitle[first.slug]}</span>
      <span class="node-state" data-node-state></span>
      <span class="node-course">Both courses</span>
    </a>
  </div>
  <svg class="fork-lines" viewBox="0 0 80 200" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 100 C40 100 40 42 80 42" />
    <path d="M0 100 C40 100 40 158 80 158" />
  </svg>
  <div class="tracks">
    {tracks.map((t) => (
      <div class:list={['track', `track-${t.cls}`]}>
        <p class="track-name">{t.name}</p>
        <ol>
          {t.list.map((u) => (
            <li>
              <a class:list={['node', `node-${t.cls}`]} href={url(`/learn/${u.slug}/`)} data-path-node={u.slug} data-path-track={t.cls}>
                <span class="node-circle"><span class="node-n">{u.apUnit}</span><span class="node-check" set:html={check} /></span>
                <span class="node-name">{shortTitle[u.slug]}</span>
                <span class="node-state" data-node-state></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</div>

<script>
  import '../scripts/path';
</script>

<style>
  .fork {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .fork {
      grid-template-columns: auto 70px 1fr;
      gap: 0;
      align-items: center;
    }
  }
  .fork-start {
    display: flex;
    justify-content: center;
  }
  .fork-lines {
    display: none;
  }
  @media (min-width: 900px) {
    .fork-lines {
      display: block;
      width: 70px;
      height: 100%;
      min-height: 280px;
      overflow: visible;
    }
    .fork-lines path {
      fill: none;
      stroke: var(--line-strong);
      stroke-width: 6;
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
    }
  }
  .tracks {
    display: grid;
    gap: 1.5rem;
  }
  .track {
    position: relative;
  }
  .track-name {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  .track-micro .track-name {
    color: var(--orange-text);
  }
  .track-macro .track-name {
    color: var(--brand);
  }
  .track ol {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 1.9rem 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
  }
  .track ol::before {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    top: calc(1.9rem + 34px);
    height: 6px;
    border-radius: 3px;
    background: var(--line-strong);
  }
  @media (max-width: 640px) {
    .track ol {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 1rem;
    }
    .track ol::before {
      display: none;
    }
  }
  .node {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
    text-decoration: none;
    color: var(--ink);
  }
  .node-circle {
    position: relative;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.7rem;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .node-both .node-circle {
    width: 96px;
    height: 96px;
    font-size: 2.3rem;
    background: var(--sun);
    color: #0b1220;
    box-shadow: 0 6px 0 var(--sun-lip);
  }
  .node-micro .node-circle {
    background: var(--orange);
    color: #0b1220;
    box-shadow: 0 6px 0 var(--orange-lip);
  }
  .node-macro .node-circle {
    background: var(--brand-fill);
    color: #fff;
    box-shadow: 0 6px 0 var(--brand-fill-lip);
  }
  .node:hover .node-circle {
    transform: translateY(-2px);
  }
  .node:active .node-circle {
    transform: translateY(6px);
    box-shadow: 0 0 0 transparent;
  }
  .node-check {
    display: none;
  }
  .node.is-done .node-n {
    display: none;
  }
  .node.is-done .node-check {
    display: block;
  }
  .node.is-next .node-circle::after {
    content: 'Start';
    position: absolute;
    top: -2.1rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.25rem 0.6rem;
    border-radius: 9px;
    border: 2px solid var(--line-strong);
    background: var(--card);
    color: var(--brand);
    font-family: var(--font-text);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: 0 3px 0 var(--line-strong);
    animation: bob 1.6s ease-in-out infinite;
  }
  .node.is-next.is-started .node-circle::after {
    content: 'Continue';
  }
  @media (prefers-reduced-motion: reduce) {
    .node.is-next .node-circle::after {
      animation: none;
    }
  }
  @keyframes bob {
    50% {
      transform: translate(-50%, -4px);
    }
  }
  .node-name {
    font-weight: 800;
    font-size: 0.92rem;
    line-height: 1.2;
    max-width: 12ch;
  }
  .node-both .node-name {
    font-size: 1.05rem;
  }
  .node-state {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--good);
    min-height: 1em;
  }
  .node-course {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-3);
  }
</style>
