---
import Logo from './Logo.astro';
import SearchDialog from './SearchDialog.astro';
import { url } from '../lib/url';
import { site } from '../site';

const links = [
  { href: '/ap-micro/', label: 'AP Micro' },
  { href: '/ap-macro/', label: 'AP Macro' },
  { href: '/practice/', label: 'Question bank' },
  { href: '/frq/', label: 'FRQs' },
  { href: '/flashcards/', label: 'Flashcards' },
  { href: '/graph-lab/', label: 'Graphs' },
];
const here = Astro.url.pathname;
const isActive = (href: string) => here.startsWith(url(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label={`${site.name} home`}>
      <Logo />
      <span class="wordmark">TutorEcon</span>
    </a>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="end">
      <button class="search-btn" type="button" data-search-open aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.2" /><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
        <span class="search-label">Search</span>
        <kbd aria-hidden="true">/</kbd>
      </button>
      <a class="stats" href={url('/account/')} data-stats hidden aria-label="Your streak and XP">
        <span class="stat stat-streak" title="Day streak">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2c.6 3.2-1.2 5-2.6 6.6C8 10.2 7 11.7 7 14a5 5 0 0 0 10 0c0-1.7-.6-3-1.4-4.1-.3 1.4-1 2.3-2 2.8.4-2.8-.2-7.2-1.6-10.7Z" fill="#ff7a1a" /><path d="M12 22a3 3 0 0 1-3-3c0-1.6 1-2.6 2-3.6.2 1 .8 1.6 1.6 1.9.1-.9.3-1.9.9-2.7.9 1 1.5 2.3 1.5 4.4a3 3 0 0 1-3 3Z" fill="#ffc53d" /></svg>
          <span data-streak>0</span>
        </span>
        <span class="stat stat-xp" title="XP earned">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M13.5 2 4 13.5h6.5L9.5 22 20 9.5h-6.8L13.5 2Z" fill="#ffc53d" stroke="#e0a000" stroke-width="1.2" stroke-linejoin="round" /></svg>
          <span data-xp>0</span>
        </span>
      </a>
      <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Switch to dark theme">
        <svg class="icon-moon" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</header>
<SearchDialog />

<script>
  import { currentTheme, store } from '../scripts/store';

  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      nav.classList.remove('is-open');
      menuBtn?.setAttribute('aria-expanded', 'false');
      menuBtn?.focus();
    }
  });

  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const syncThemeBtn = () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    themeBtn?.setAttribute('aria-label', `Switch to ${next} theme`);
    themeBtn?.setAttribute('data-current', currentTheme());
  };
  themeBtn?.addEventListener('click', () => {
    store.setTheme(currentTheme() === 'dark' ? 'light' : 'dark');
    syncThemeBtn();
    window.dispatchEvent(new CustomEvent('tutorecon:theme'));
  });
  syncThemeBtn();

  // Streak and XP, only once the reader has earned some.
  const stats = document.querySelector<HTMLAnchorElement>('[data-stats]');
  const syncStats = () => {
    const data = store.get();
    const streak = store.currentStreak();
    if (!stats) return;
    stats.hidden = data.xp <= 0;
    stats.querySelector('[data-streak]')!.textContent = String(streak);
    stats.querySelector('[data-xp]')!.textContent = String(data.xp);
    stats.setAttribute('aria-label', `${streak} day streak, ${data.xp} XP. Open your progress.`);
    stats.classList.toggle('is-cold', streak === 0);
  };
  window.addEventListener('tutorecon:change', syncStats);
  syncStats();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
  }
  .nav {
    flex: 1;
  }
  .nav ul {
    display: flex;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 64px;
    padding: 0 0.7rem;
    text-decoration: none;
    font-weight: 600;
    color: var(--ink-2);
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav a[aria-current='page'] {
    color: var(--ink);
  }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: -1px;
    height: 3px;
    background: var(--brand);
  }
  .end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }
  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 0.6rem 0 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-2);
    color: var(--ink-2);
    font-weight: 500;
    cursor: pointer;
  }
  .search-btn:hover {
    color: var(--ink);
    border-color: var(--control);
  }
  .search-btn kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .stats {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    min-height: 40px;
    padding: 0 0.35rem;
    border-radius: var(--radius);
    text-decoration: none;
    border: 1px solid var(--line);
  }
  .stats:hover {
    background: var(--bg-2);
  }
  .stat {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.1rem 0.3rem;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .stat-streak {
    color: var(--orange-text);
  }
  .is-cold .stat-streak {
    color: var(--ink-3);
    filter: grayscale(1);
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink-2);
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .icon-sun {
    display: none;
  }
  .theme-btn[data-current='dark'] .icon-sun {
    display: block;
  }
  .theme-btn[data-current='dark'] .icon-moon {
    display: none;
  }
  .menu-btn {
    display: none;
  }
  @media (max-width: 1120px) {
    .menu-btn {
      display: inline-grid;
    }
    .nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      padding: 0.5rem var(--gutter) 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-lg);
    }
    .nav.is-open {
      display: block;
    }
    .nav ul {
      flex-direction: column;
    }
    .nav a {
      min-height: 48px;
      font-size: 1.05rem;
      width: 100%;
      padding: 0 0.25rem;
    }
    .nav a[aria-current='page']::after {
      left: 0;
      right: auto;
      top: 12px;
      bottom: 12px;
      width: 3px;
      height: auto;
      margin-left: -0.75rem;
    }
  }
  @media (max-width: 560px) {
    .search-label,
    .search-btn kbd {
      display: none;
    }
    .search-btn {
      width: 40px;
      padding: 0;
      justify-content: center;
    }
    .stats {
      display: none;
    }
    .wordmark {
      font-size: 1.2rem;
    }
    .bar {
      gap: 0.75rem;
    }
  }
</style>
