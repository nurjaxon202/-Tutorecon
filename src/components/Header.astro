---
import Logo from './Logo.astro';
import { url } from '../lib/url';
import { site } from '../site';

const links = [
  { href: '/learn/', label: 'Units' },
  { href: '/practice/', label: 'Practice' },
  { href: '/graph-lab/', label: 'Graph lab' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/pricing/', label: 'Pricing' },
];
const here = Astro.url.pathname;
const isActive = (href: string) => here.startsWith(url(href));
---
<header class="site-header on-board">
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label={`${site.name} home`}>
      <Logo />
      <span class="wordmark">{site.name}</span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      Menu
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <div class="nav-end">
        <button class="theme-btn" type="button" data-theme-toggle aria-label="Switch to dark theme">
          <svg class="icon-moon" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          <span class="theme-label">Theme</span>
        </button>
        <a class="btn btn-small start" href={url('/learn/foundations/')}>Start learning</a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { currentTheme, store } from '../scripts/store';

  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      nav.classList.remove('is-open');
      menuBtn?.setAttribute('aria-expanded', 'false');
      menuBtn?.focus();
    }
  });

  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const syncThemeBtn = () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    themeBtn?.setAttribute('aria-label', `Switch to ${next} theme`);
    themeBtn?.setAttribute('data-current', currentTheme());
  };
  themeBtn?.addEventListener('click', () => {
    store.setTheme(currentTheme() === 'dark' ? 'light' : 'dark');
    syncThemeBtn();
    window.dispatchEvent(new CustomEvent('tutorecon:theme'));
  });
  syncThemeBtn();
</script>

<style>
  .site-header {
    position: relative;
    z-index: 30;
    border-bottom: 1px solid rgba(243, 246, 240, 0.12);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--chalk);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.42rem;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav ul {
    display: flex;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a:not(.btn) {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    color: var(--chalk-2);
  }
  .nav a:not(.btn):hover {
    color: var(--chalk);
    background: rgba(243, 246, 240, 0.08);
  }
  .nav a[aria-current='page'] {
    color: var(--chalk);
  }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 5px;
    height: 3px;
    border-radius: 2px;
    background: var(--hl);
  }
  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .theme-btn,
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 40px;
    min-width: 40px;
    justify-content: center;
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(243, 246, 240, 0.28);
    border-radius: var(--radius);
    background: transparent;
    color: var(--chalk-2);
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .theme-btn:hover,
  .menu-btn:hover {
    color: var(--chalk);
    border-color: rgba(243, 246, 240, 0.55);
  }
  .icon-sun {
    display: none;
  }
  .theme-btn[data-current='dark'] .icon-sun {
    display: block;
  }
  .theme-btn[data-current='dark'] .icon-moon {
    display: none;
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 1060px) {
    .theme-label {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .menu-btn {
      display: inline-flex;
    }
    .nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding: 0.75rem var(--gutter) 1.25rem;
      background: var(--board);
      border-bottom: 1px solid rgba(243, 246, 240, 0.12);
      box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.5);
    }
    .nav.is-open {
      display: flex;
    }
    .nav ul {
      flex-direction: column;
    }
    .nav a:not(.btn) {
      min-height: 48px;
      font-size: 1.08rem;
    }
    .nav a[aria-current='page']::after {
      left: 0.75rem;
      right: auto;
      width: 2.5rem;
    }
    .nav-end {
      justify-content: space-between;
    }
    .theme-label {
      display: inline;
    }
  }
</style>
