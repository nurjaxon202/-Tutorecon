---
import Base from './Base.astro';
import PageBand from '../components/PageBand.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  updated?: string;
}
const { title, description, eyebrow, updated } = Astro.props;
---
<Base title={title} description={description}>
  <PageBand eyebrow={eyebrow} title={title}>
    {updated && <p class="mono updated">Last updated {updated}</p>}
  </PageBand>
  <div class="wrap doc">
    <div class="prose doc-body">
      <slot />
    </div>
  </div>
</Base>

<style>
  .doc {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-bottom: 5rem;
  }
  .updated {
    font-size: 0.82rem;
    color: var(--chalk-2);
  }
  .doc-body :global(h2:first-child) {
    margin-top: 0;
  }
  .doc-body :global(.summary) {
    padding: 1.1rem 1.2rem;
    border-left: 5px solid var(--hl);
    background: color-mix(in srgb, var(--hl) 16%, var(--paper-raised));
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 1.05rem;
  }
</style>
