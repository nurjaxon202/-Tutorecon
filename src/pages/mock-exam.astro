---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import ProGate from '../components/ProGate.astro';
import { courses } from '../data/ced';
import { url } from '../lib/url';

// Unit weights use the midpoint of each published range, so a full exam
// draws questions in roughly the same proportions as the real one.
const mid = (w: string) => {
  const [a, b] = w.replace('%', '').split(' to ').map(Number);
  return (a + b) / 2;
};
const plan = Object.fromEntries(
  courses.map((c) => [c.id, { short: c.short, prefix: c.id === 'micro' ? 'mi' : 'ma', units: c.units.map((u) => ({ n: u.n, title: u.title, weight: mid(u.weight) })) }]),
);
---
<Base title="Mock exam" description="A timed, mixed AP Economics practice exam with a score breakdown by unit. Part of TutorEcon Pro.">
  <PageBand
    eyebrow="Pro · Mock exam"
    title="Mock exam"
    lede="A timed multiple-choice exam at the real pace: 60 questions in 70 minutes, or a 30-question half exam in 35. Questions are drawn in proportion to each unit’s share of the exam, and you get a score for each unit at the end."
  />

  <div class="wrap body">
    <ProGate feature="Mock exams">
      <div class="exam" data-exam data-src={url('/questions.json')}>
        <section class="stage panel setup" data-stage="setup" aria-labelledby="setup-title">
          <h2 id="setup-title" class="h3">Set up your exam</h2>
          <fieldset class="ctl-choice">
            <legend>Course</legend>
            <div class="seg">
              <label><input type="radio" name="exam-course" value="micro" checked /><span>AP Micro</span></label>
              <label><input type="radio" name="exam-course" value="macro" /><span>AP Macro</span></label>
            </div>
          </fieldset>
          <fieldset class="ctl-choice">
            <legend>Length</legend>
            <div class="seg">
              <label><input type="radio" name="exam-length" value="60" checked /><span>Full: 60 questions, 70 minutes</span></label>
              <label><input type="radio" name="exam-length" value="30" /><span>Half: 30 questions, 35 minutes</span></label>
            </div>
          </fieldset>
          <p class="muted">The timer starts when you press Start. You can move between questions and change answers until you finish. If time runs out, the exam is scored as it stands.</p>
          <button type="button" class="btn" data-start>Start the exam</button>
          <div class="history" data-history hidden>
            <h3 class="history-title">Your recent exams</h3>
            <ol data-history-list></ol>
          </div>
        </section>

        <section class="stage run" data-stage="run" hidden aria-label="Exam in progress">
          <div class="run-bar">
            <p class="mono run-count" data-count-label></p>
            <p class="mono timer" role="timer" aria-label="Time remaining" data-timer></p>
            <button type="button" class="btn btn-secondary btn-small" data-finish>Finish exam</button>
          </div>
          <p class="visually-hidden" aria-live="assertive" data-time-alert></p>

          <div class="confirm panel" data-confirm hidden role="alertdialog" aria-labelledby="confirm-text">
            <p id="confirm-text" data-confirm-text></p>
            <div class="btn-row">
              <button type="button" class="btn btn-small" data-confirm-yes>Finish and see my score</button>
              <button type="button" class="btn btn-secondary btn-small" data-confirm-no>Keep going</button>
            </div>
          </div>

          <form class="qcard exam-card" data-card onsubmit="return false">
            <fieldset>
              <legend>
                <span class="q-unit mono" data-q-unit></span>
                <span class="q-prompt" data-q-prompt tabindex="-1"></span>
              </legend>
              <div class="q-table" data-q-table hidden></div>
              <div class="q-options" data-q-options></div>
            </fieldset>
          </form>

          <div class="run-nav">
            <button type="button" class="btn btn-secondary" data-prev>Previous</button>
            <button type="button" class="btn" data-next>Next question</button>
          </div>

          <nav class="qmap" aria-label="Jump to a question">
            <p class="ctl-heading">All questions</p>
            <ol data-qmap></ol>
          </nav>
        </section>

        <section class="stage results" data-stage="results" hidden aria-labelledby="results-title" tabindex="-1">
          <p class="eyebrow">Results</p>
          <h2 id="results-title" class="result-score" data-result-score></h2>
          <p class="muted" data-result-meta></p>
          <div class="table-wrap">
            <table class="by-unit">
              <caption class="visually-hidden">Score by unit</caption>
              <thead><tr><th scope="col">Unit</th><th scope="col">Correct</th><th scope="col">Score</th></tr></thead>
              <tbody data-by-unit></tbody>
            </table>
          </div>
          <h3 class="h3 review-title">Questions to review</h3>
          <ol class="review-list" data-review></ol>
          <div class="btn-row">
            <button type="button" class="btn" data-again>Take another exam</button>
          </div>
        </section>
      </div>
    </ProGate>
  </div>
  <script type="application/json" data-plan set:html={JSON.stringify(plan)} />
</Base>

<script>
  import { store } from '../scripts/store';

  interface Q {
    id: string;
    t: string[];
    p: string;
    tb?: { head: string[]; rows: (string | number)[][] };
    o: [string, string][];
    a: number;
  }
  interface Plan {
    short: string;
    prefix: string;
    units: { n: number; title: string; weight: number }[];
  }

  const root = document.querySelector<HTMLElement>('[data-exam]');
  const planRaw = document.querySelector('[data-plan]')?.textContent;
  if (root && planRaw) {
    const plans = JSON.parse(planRaw) as Record<'micro' | 'macro', Plan>;
    const letters = ['A', 'B', 'C', 'D', 'E'];
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const stages = { setup: $('[data-stage="setup"]'), run: $('[data-stage="run"]'), results: $('[data-stage="results"]') };

    let bank: Q[] = [];
    let exam: { q: Q; unit: number }[] = [];
    let answers: (number | null)[] = [];
    let current = 0;
    let seconds = 0;
    let remaining = 0;
    let timer = 0;
    let course: 'micro' | 'macro' = 'micro';

    const esc = (s: string | number) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
    const fmt = (s: number) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    const show = (name: keyof typeof stages) => {
      Object.entries(stages).forEach(([k, el]) => (el.hidden = k !== name));
    };
    const shuffle = <T,>(a: T[]) => {
      const b = [...a];
      for (let i = b.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [b[i], b[j]] = [b[j], b[i]];
      }
      return b;
    };

    // Pick questions unit by unit in proportion to each unit's weight.
    const build = (c: 'micro' | 'macro', n: number) => {
      const plan = plans[c];
      const total = plan.units.reduce((s, u) => s + u.weight, 0);
      const targets = plan.units.map((u) => ({ n: u.n, want: (u.weight / total) * n }));
      const counts = targets.map((t) => Math.floor(t.want));
      let left = n - counts.reduce((a, b) => a + b, 0);
      targets
        .map((t, i) => ({ i, frac: t.want - Math.floor(t.want) }))
        .sort((a, b) => b.frac - a.frac)
        .forEach(({ i }) => {
          if (left > 0) {
            counts[i]++;
            left--;
          }
        });
      const used = new Set<string>();
      const out: { q: Q; unit: number }[] = [];
      plan.units.forEach((u, i) => {
        const pool = shuffle(bank.filter((q) => !used.has(q.id) && q.t.some((t) => t.startsWith(`${plan.prefix}${u.n}.`))));
        for (const q of pool.slice(0, counts[i])) {
          used.add(q.id);
          out.push({ q, unit: u.n });
        }
      });
      return shuffle(out);
    };

    const renderHistory = () => {
      const exams = store.get().exams;
      const box = $('[data-history]');
      box.hidden = exams.length === 0;
      $('[data-history-list]').innerHTML = exams
        .slice(0, 5)
        .map((e) => `<li><span class="mono">${e.score}/${e.total}</span> ${e.course === 'micro' ? 'AP Micro' : e.course === 'macro' ? 'AP Macro' : 'Mixed'} <span class="muted">${new Date(e.at).toLocaleDateString()}</span></li>`)
        .join('');
    };

    const renderMap = () => {
      $('[data-qmap]').innerHTML = exam
        .map((_, i) => {
          const done = answers[i] !== null;
          return `<li><button type="button" data-jump="${i}" class="${done ? 'is-answered' : ''}" ${i === current ? 'aria-current="step"' : ''} aria-label="Question ${i + 1}, ${done ? 'answered' : 'not answered'}">${i + 1}</button></li>`;
        })
        .join('');
    };

    const renderQuestion = (focus = true) => {
      const { q, unit } = exam[current];
      $('[data-count-label]').textContent = `Question ${current + 1} of ${exam.length}`;
      $('[data-q-unit]').textContent = `${plans[course].short} Unit ${unit}`;
      $('[data-q-prompt]').textContent = q.p;
      const tb = $('[data-q-table]');
      tb.hidden = !q.tb;
      tb.innerHTML = q.tb
        ? `<table><thead><tr>${q.tb.head.map((h) => `<th scope="col">${esc(h)}</th>`).join('')}</tr></thead><tbody>${q.tb.rows
            .map((r) => `<tr>${r.map((c) => `<td>${esc(c)}</td>`).join('')}</tr>`)
            .join('')}</tbody></table>`
        : '';
      $('[data-q-options]').innerHTML = q.o
        .map(
          ([o], j) =>
            `<label class="q-opt"><input type="radio" name="exam-q" value="${j}" ${answers[current] === j ? 'checked' : ''} /><span class="q-letter mono" aria-hidden="true">${letters[j]}</span><span class="q-text">${esc(o)}</span></label>`,
        )
        .join('');
      $<HTMLButtonElement>('[data-prev]').disabled = current === 0;
      $('[data-next]').textContent = current === exam.length - 1 ? 'Review and finish' : 'Next question';
      renderMap();
      if (focus) $('[data-q-prompt]').focus({ preventScroll: true });
    };

    const tick = () => {
      remaining--;
      $('[data-timer]').textContent = fmt(Math.max(0, remaining));
      const alert = $('[data-time-alert]');
      if (remaining === 300) alert.textContent = 'Five minutes left.';
      if (remaining === 60) alert.textContent = 'One minute left.';
      $('[data-timer]').classList.toggle('is-low', remaining <= 60);
      if (remaining <= 0) finish();
    };

    const start = () => {
      if (!bank.length) return;
      course = (root.querySelector<HTMLInputElement>('input[name="exam-course"]:checked')?.value ?? 'micro') as 'micro' | 'macro';
      const n = Number(root.querySelector<HTMLInputElement>('input[name="exam-length"]:checked')?.value ?? 60);
      exam = build(course, n);
      answers = exam.map(() => null);
      current = 0;
      seconds = Math.round((n / 60) * 70 * 60);
      remaining = seconds;
      $('[data-timer]').textContent = fmt(remaining);
      $('[data-confirm]').hidden = true;
      show('run');
      renderQuestion();
      window.clearInterval(timer);
      timer = window.setInterval(tick, 1000);
    };

    const finish = () => {
      window.clearInterval(timer);
      const used = seconds - Math.max(0, remaining);
      const score = exam.reduce((n, { q }, i) => n + (answers[i] === q.a ? 1 : 0), 0);
      store.saveExam({ score, total: exam.length, course, at: Date.now() });
      exam.forEach(({ q }, i) => {
        if (answers[i] !== null) store.recordAnswer(q.id, answers[i] === q.a);
      });

      $('[data-result-score]').innerHTML = `<span class="mono">${score}</span> of <span class="mono">${exam.length}</span> correct`;
      const unanswered = answers.filter((a) => a === null).length;
      $('[data-result-meta]').textContent = `${Math.round((score / exam.length) * 100)}% in ${fmt(used)}${unanswered ? `, with ${unanswered} left blank` : ''}.`;

      const byUnit = new Map<number, { right: number; total: number }>();
      exam.forEach(({ q, unit }, i) => {
        const r = byUnit.get(unit) ?? { right: 0, total: 0 };
        r.total++;
        if (answers[i] === q.a) r.right++;
        byUnit.set(unit, r);
      });
      $('[data-by-unit]').innerHTML = plans[course].units
        .filter((u) => byUnit.has(u.n))
        .map((u) => {
          const r = byUnit.get(u.n)!;
          const pct = Math.round((r.right / r.total) * 100);
          return `<tr><th scope="row">Unit ${u.n}: ${esc(u.title)}</th><td class="mono">${r.right}/${r.total}</td><td><span class="bar" style="--p:${pct}%"><span></span></span><span class="mono small">${pct}%</span></td></tr>`;
        })
        .join('');

      const missed = exam.map(({ q, unit }, i) => ({ q, unit, a: answers[i], n: i + 1 })).filter((x) => x.a !== x.q.a);
      $('[data-review]').innerHTML = missed.length
        ? missed
            .map(
              ({ q, unit, a, n }) =>
                `<li class="review-item"><p class="small">Question ${n} · ${plans[course].short} Unit ${unit}</p><p class="review-prompt">${esc(q.p)}</p>` +
                (a === null ? '<p class="q-wrong">You left this blank.</p>' : `<p class="q-wrong">You chose ${letters[a]}: ${esc(q.o[a][0])}. ${esc(q.o[a][1])}</p>`) +
                `<p><strong>Answer ${letters[q.a]}: ${esc(q.o[q.a][0])}.</strong> ${esc(q.o[q.a][1].replace(/^Correct\.\s*/, ''))}</p></li>`,
            )
            .join('')
        : '<li class="review-item"><p>Nothing to review. Every answer was right.</p></li>';

      show('results');
      stages.results.focus();
      renderHistory();
    };

    const askFinish = () => {
      const blank = answers.filter((a) => a === null).length;
      $('[data-confirm-text]').textContent = blank
        ? `You have ${blank} unanswered question${blank === 1 ? '' : 's'}. Finish anyway?`
        : 'You have answered every question. Finish and see your score?';
      $('[data-confirm]').hidden = false;
      $<HTMLButtonElement>('[data-confirm-yes]').focus();
    };

    root.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'exam-q') {
        answers[current] = Number(t.value);
        renderMap();
      }
    });
    root.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-jump]');
      if (t) {
        current = Number(t.dataset.jump);
        renderQuestion();
      }
    });
    const startBtn = $<HTMLButtonElement>('[data-start]');
    startBtn.disabled = true;
    startBtn.addEventListener('click', start);
    $('[data-again]').addEventListener('click', () => {
      show('setup');
      startBtn.focus();
    });
    $('[data-prev]').addEventListener('click', () => {
      if (current > 0) {
        current--;
        renderQuestion();
      }
    });
    $('[data-next]').addEventListener('click', () => {
      if (current < exam.length - 1) {
        current++;
        renderQuestion();
      } else askFinish();
    });
    $('[data-finish]').addEventListener('click', askFinish);
    $('[data-confirm-yes]').addEventListener('click', finish);
    $('[data-confirm-no]').addEventListener('click', () => {
      $('[data-confirm]').hidden = true;
      $('[data-q-prompt]').focus();
    });

    fetch(root.dataset.src!)
      .then((r) => r.json())
      .then((data: Q[]) => {
        bank = data;
        startBtn.disabled = false;
      });
    renderHistory();
  }
</script>

<style>
  .lede {
    max-width: 56ch;
  }
  .body {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }
  .exam {
    max-width: 820px;
  }
  .stage[hidden] {
    display: none;
  }
  .setup {
    padding: 1.5rem;
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .history {
    width: 100%;
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }
  .history-title {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .history :global(ol) {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 0.3rem;
  }
  .run {
    display: grid;
    gap: 1rem;
  }
  .run-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    position: sticky;
    top: 0.5rem;
    z-index: 5;
  }
  .run-count {
    font-size: 0.9rem;
  }
  .timer {
    font-size: 1.35rem;
    font-weight: 500;
  }
  .timer.is-low {
    color: var(--bad);
  }
  .confirm {
    padding: 1rem 1.1rem;
    display: grid;
    gap: 0.75rem;
    border-color: var(--ink);
  }
  .confirm[hidden] {
    display: none;
  }
  .exam-card :global(.q-prompt:focus) {
    outline: none;
  }
  .run-nav {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .qmap ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(42px, 1fr));
    gap: 0.4rem;
  }
  .qmap :global(button) {
    width: 100%;
    min-height: 42px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper-raised);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .qmap :global(button.is-answered) {
    background: var(--paper-sunk);
    border-color: var(--ink-3);
    box-shadow: inset 0 -4px 0 var(--ink-3);
  }
  .qmap :global(button[aria-current]) {
    border: 2px solid var(--ink);
    font-weight: 700;
  }
  .results {
    display: grid;
    gap: 1rem;
  }
  .results:focus {
    outline: none;
  }
  .result-score {
    font-weight: 400;
    font-size: clamp(2rem, 1.5rem + 2vw, 2.8rem);
  }
  .table-wrap {
    overflow-x: auto;
  }
  .by-unit {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .by-unit th,
  .by-unit td {
    text-align: left;
    padding: 0.6rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: middle;
  }
  .by-unit thead th {
    border-bottom: 1.5px solid var(--ink);
    font-weight: 650;
  }
  .by-unit :global(th[scope='row']) {
    font-weight: 600;
  }
  .by-unit :global(.small),
  .results :global(.small) {
    font-size: 0.74rem;
    color: var(--ink-2);
    font-weight: 400;
  }
  .by-unit :global(.bar) {
    display: inline-block;
    vertical-align: middle;
    width: 90px;
    height: 8px;
    margin-right: 0.5rem;
    border-radius: 4px;
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .by-unit :global(.bar span) {
    display: block;
    height: 100%;
    width: var(--p);
    background: var(--ink);
  }
  .review-title {
    margin-top: 1.5rem;
  }
  .review-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .review-list :global(.review-item) {
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-body);
    line-height: 1.5;
  }
  .review-list :global(.review-prompt) {
    font-weight: 600;
  }
</style>
