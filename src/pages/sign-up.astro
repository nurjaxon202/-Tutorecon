---
import AuthShell from '../components/AuthShell.astro';
import GoogleButton from '../components/GoogleButton.astro';
import { googleOn, MAX_NAME, MIN_PASSWORD } from '../lib/accounts';
import { url } from '../lib/url';
---
<AuthShell
  title="Create your account"
  description="Create a free TutorEcon account to keep your AP Economics progress and use it on any device."
  lede="Free, with no card and no trial. Your progress follows you to any device, and anything you have already done in this browser comes with you."
>
  <div class="auth-stack" data-signup-area>
    {googleOn && (
      <>
        <GoogleButton next="/welcome/" />
        <p class="or">or sign up with email</p>
      </>
    )}

    <form class="auth-form" novalidate data-signup>
      <div class="field">
        <label for="su-name">First name <span class="opt">(optional)</span></label>
        <input id="su-name" type="text" class="input" autocomplete="given-name" maxlength={MAX_NAME} aria-describedby="su-name-hint" />
        <p id="su-name-hint" class="hint">Used only to greet you on your dashboard.</p>
      </div>

      <div class="field">
        <label for="su-email">Email</label>
        <input id="su-email" type="email" class="input" autocomplete="email" spellcheck="false" required aria-describedby="su-email-error" aria-invalid="false" />
        <p id="su-email-error" class="error-text" data-error="email"></p>
      </div>

      <div class="field">
        <label for="su-password">Password</label>
        <div class="pw">
          <input id="su-password" type="password" class="input" autocomplete="new-password" required minlength={MIN_PASSWORD} aria-describedby="su-password-hint su-password-meter su-password-error" aria-invalid="false" />
          <button type="button" class="reveal" data-reveal aria-controls="su-password" aria-pressed="false" aria-label="Show password">Show</button>
        </div>
        <div class="meter" data-meter="su-password" data-score="0" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <p id="su-password-meter" class="meter-text" data-meter-text="su-password" aria-live="polite"></p>
        <p id="su-password-hint" class="hint">At least {MIN_PASSWORD} characters. A few unrelated words in a row are easy to remember and hard to guess.</p>
        <p id="su-password-error" class="error-text" data-error="password"></p>
      </div>

      <div class="field">
        <label class="check">
          <input type="checkbox" id="su-consent" aria-describedby="su-consent-error" aria-invalid="false" />
          <span>I am 13 or older, and I agree to the <a href={url('/terms/')}>Terms of use</a> and the <a href={url('/privacy/')}>Privacy policy</a>.</span>
        </label>
        <p id="su-consent-error" class="error-text" data-error="consent"></p>
      </div>

      <p class="error-text form-error" role="alert" data-error="form"></p>
      <button type="submit" class="btn btn-big" data-submit>Create account</button>
    </form>

    <p class="switch">Already have an account? <a href={url('/sign-in/')}>Sign in</a></p>
  </div>

  <div class="sent" data-sent hidden>
    <h2 class="h3" tabindex="-1" data-sent-title>Check your email</h2>
    <p>We sent a link to <strong data-sent-to></strong>. Open it to confirm your address, and you will come back here signed in.</p>
    <ol class="steps">
      <li>Open the email we just sent.</li>
      <li>Select the link in it to confirm your address.</li>
      <li>Set up your study plan, or skip straight to studying.</li>
    </ol>
    <p class="hint" data-sent-hint>Nothing after a few minutes? Check your spam folder.</p>
    <div class="btn-row">
      <button type="button" class="btn btn-secondary btn-small" data-resend>Send the email again</button>
      <button type="button" class="btn btn-secondary btn-small" data-restart>Use a different email</button>
    </div>
  </div>
</AuthShell>

<script>
  import { accountsOn, authMessage, connect, onAuth, resendConfirmation, settled, waitForSession } from '../scripts/account';
  import { MAX_NAME, MIN_PASSWORD } from '../lib/accounts';
  import { busy, cooldown, emailOk, fieldError, wireMeter, wireReveal } from '../scripts/forms';
  import { toastNext } from '../scripts/toast';
  import { url } from '../lib/url';

  const form = document.querySelector<HTMLFormElement>('[data-signup]');
  if (accountsOn && form) {
    const area = document.querySelector<HTMLElement>('[data-signup-area]')!;
    const name = form.querySelector<HTMLInputElement>('#su-name')!;
    const email = form.querySelector<HTMLInputElement>('#su-email')!;
    const password = form.querySelector<HTMLInputElement>('#su-password')!;
    const consent = form.querySelector<HTMLInputElement>('#su-consent')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const sent = document.querySelector<HTMLElement>('[data-sent]')!;
    const resend = sent.querySelector<HTMLButtonElement>('[data-resend]')!;
    let signingUp = false;
    wireReveal(form);
    const measure = wireMeter(password, email, MIN_PASSWORD);

    // Someone who is already signed in does not need this page.
    onAuth((s) => {
      if (s && !signingUp) location.replace(url('/dashboard/'));
    });

    const check = () => {
      let ok = true;
      const e = email.value.trim();
      const eMsg = !e ? 'Enter your email address.' : emailOk(e) ? '' : 'Enter an email address like name@example.com.';
      fieldError(form, 'email', eMsg, email);
      const pMsg = measure().problem;
      fieldError(form, 'password', pMsg, password);
      const cMsg = consent.checked ? '' : 'Please confirm your age and that you agree to the terms.';
      fieldError(form, 'consent', cMsg, consent);
      for (const [msg, el] of [[eMsg, email], [pMsg, password], [cMsg, consent]] as const) {
        if (msg && ok) {
          el.focus();
          ok = false;
        }
      }
      return ok;
    };

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      fieldError(form, 'form', '');
      if (!check()) return;
      busy(submit, true, 'Creating account');
      signingUp = true;
      const first = name.value.trim().replace(/\s+/g, ' ').slice(0, MAX_NAME);
      try {
        const client = await connect();
        const { data, error } = await client.auth.signUp({
          email: email.value.trim(),
          password: password.value,
          options: { emailRedirectTo: new URL(url('/welcome/'), location.origin).href, data: first ? { name: first } : {} },
        });
        if (error) throw error;
        if (data.session) {
          // Email confirmation is off in this project, so the account is ready now.
          await waitForSession();
          await settled();
          toastNext('Your account is ready.');
          location.assign(url('/welcome/'));
          return;
        }
        sent.querySelector('[data-sent-to]')!.textContent = email.value.trim();
        area.hidden = true;
        sent.hidden = false;
        sent.querySelector<HTMLElement>('[data-sent-title]')!.focus();
        cooldown(resend, 'Send the email again');
      } catch (err) {
        fieldError(form, 'form', authMessage(err));
      } finally {
        signingUp = false;
        busy(submit, false, 'Create account');
      }
    });

    resend.addEventListener('click', async () => {
      const hint = sent.querySelector<HTMLElement>('[data-sent-hint]')!;
      try {
        await resendConfirmation(email.value.trim(), '/welcome/');
        hint.textContent = 'Sent again. It can take a minute or two to arrive.';
        cooldown(resend, 'Send the email again');
      } catch (err) {
        hint.textContent = authMessage(err);
      }
    });

    sent.querySelector('[data-restart]')!.addEventListener('click', () => {
      sent.hidden = true;
      area.hidden = false;
      password.value = '';
      measure();
      email.focus();
      email.select();
    });
  }
</script>

<style>
  .auth-stack {
    display: grid;
    gap: 1.1rem;
  }
  .opt {
    font-weight: 400;
    color: var(--ink-2);
  }
  .switch {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .sent {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--good-tint);
  }
  .sent h2:focus {
    outline: none;
  }
  .steps {
    margin: 0;
    padding-left: 1.3rem;
    display: grid;
    gap: 0.3rem;
  }
</style>
