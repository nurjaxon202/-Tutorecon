---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import Graph from '../components/Graph.astro';
import { graphList } from '../scripts/graphs/models';
import { units, unitLabel, getUnit } from '../data/units';
import { url } from '../lib/url';

const order = (slug: string) => units.findIndex((u) => u.slug === slug);
const list = [...graphList].sort((a, b) => order(a.unit) - order(b.unit));
---
<Base title="Graph lab" description="Every interactive economics graph on TutorEcon in one place: supply and demand, price controls, taxes, cost curves, monopoly, AD-AS, the money market, and more.">
  <PageBand
    eyebrow="Graph lab"
    title="Every graph, ready to move"
    lede="Pick a diagram and push it around until the pattern makes sense. Each one links back to the unit that explains it."
  />

  <div class="wrap lab">
    <nav class="lab-nav" aria-label="Graphs">
      <label class="field lab-select">
        <span class="label">Choose a graph</span>
        <select class="select" data-lab-select>
          {list.map((g) => <option value={g.key}>{g.label}</option>)}
        </select>
      </label>
      <ol class="lab-list">
        {list.map((g) => (
          <li>
            <a class:list={['lab-item', `course-${getUnit(g.unit)!.course}`]} href={`#${g.key}`} data-lab-link={g.key}>
              <span class="lab-dot" aria-hidden="true"></span>
              <span class="lab-name">{g.label}</span>
              <span class="lab-unit">{unitLabel(getUnit(g.unit)!)}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="lab-stage">
      {list.map((g) => {
        const u = getUnit(g.unit)!;
        return (
          <section class="lab-panel" id={g.key} data-lab-panel={g.key} aria-label={g.label}>
            <Graph model={g.key} />
            <p class="lab-link">
              Explained in <a href={url(`/learn/${u.slug}/`)}>{unitLabel(u)}: {u.title}</a>
            </p>
          </section>
        );
      })}
    </div>
  </div>
</Base>

<script>
  const panels = document.querySelectorAll<HTMLElement>('[data-lab-panel]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-lab-link]');
  const select = document.querySelector<HTMLSelectElement>('[data-lab-select]');
  const keys = [...panels].map((p) => p.dataset.labPanel!);

  const show = (key: string, focus = false) => {
    if (!keys.includes(key)) key = keys[0];
    panels.forEach((p) => (p.hidden = p.dataset.labPanel !== key));
    links.forEach((a) => {
      if (a.dataset.labLink === key) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
    if (select) select.value = key;
    if (focus) document.getElementById(key)?.querySelector<HTMLElement>('input, button')?.focus({ preventScroll: true });
  };

  links.forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', `#${a.dataset.labLink}`);
      show(a.dataset.labLink!);
    }),
  );
  select?.addEventListener('change', () => {
    history.replaceState(null, '', `#${select.value}`);
    show(select.value);
  });
  window.addEventListener('hashchange', () => show(location.hash.slice(1)));
  document.documentElement.classList.add('lab-js');
  show(location.hash.slice(1));
</script>

<style>
  .lede {
    max-width: 56ch;
  }
  .lab {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 5rem;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .lab {
      grid-template-columns: 290px minmax(0, 1fr);
      gap: 2.5rem;
    }
    .lab-nav {
      position: sticky;
      top: 96px;
      max-height: calc(100vh - 116px);
      overflow-y: auto;
      padding: 0.6rem;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--card);
    }
    .lab-select {
      display: none;
    }
  }
  @media (max-width: 999px) {
    .lab-list {
      display: none;
    }
  }
  .lab-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.2rem;
  }
  .lab-item {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.65rem;
    align-items: center;
    padding: 0.55rem 0.7rem;
    border: 2px solid transparent;
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    line-height: 1.25;
  }
  .lab-item:hover {
    background: var(--bg-2);
  }
  .lab-item[aria-current] {
    background: var(--brand-tint);
    border-color: var(--brand);
    box-shadow: 0 3px 0 var(--brand);
  }
  .lab-dot {
    grid-row: span 2;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--brand-fill);
  }
  .course-micro .lab-dot {
    background: var(--orange);
  }
  .course-both .lab-dot {
    background: var(--sun-lip);
  }
  .lab-name {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .lab-unit {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .lab-item[aria-current] .lab-unit {
    color: var(--ink-2);
  }
  .lab-stage {
    display: grid;
    gap: 2rem;
    min-width: 0;
  }
  .lab-panel[hidden] {
    display: none;
  }
  .lab-link {
    margin-top: 1rem;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--ink-2);
  }
</style>
