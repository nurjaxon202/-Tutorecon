---
import Base from '../../layouts/Base.astro';
import ProGate from '../../components/ProGate.astro';
import { units, unitLabel } from '../../data/units';
import { url } from '../../lib/url';
---
<Base title="Review sheets" description="Printable one-page review sheets for every AP Microeconomics and Macroeconomics unit. Part of TutorEcon Pro.">
  <header class="wrap page-head">
    <p class="eyebrow">Pro · Review sheets</p>
    <h1 class="page-title">Review sheets</h1>
    <p class="lede">One page per unit: what you must know, the formulas, the graphs to practice drawing, and the traps that cost points. Made to print.</p>
  </header>
  <div class="wrap body">
    <ProGate feature="Review sheets">
      <ol class="sheet-list">
        {units.map((u) => (
          <li>
            <a href={url(`/review/${u.slug}/`)}>
              <span class="mono label">{unitLabel(u)}</span>
              <span class="title">{u.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </ProGate>
  </div>
</Base>

<style>
  .page-head {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    display: grid;
    gap: 0.9rem;
  }
  .lede {
    max-width: 56ch;
  }
  .body {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }
  .sheet-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 720px) {
    .sheet-list {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
  }
  .sheet-list a {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    text-decoration: none;
    height: 100%;
  }
  .sheet-list a:hover {
    border-color: var(--ink);
  }
  .label {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--ink-2);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
    line-height: 1.25;
  }
</style>
