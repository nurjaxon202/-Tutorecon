---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import { glossary, termSlug } from '../data/glossary';
import { getUnit, unitLabel } from '../data/units';
import { url } from '../lib/url';

const terms = [...glossary].sort((a, b) => a.term.localeCompare(b.term));
const letters = [...new Set(terms.map((t) => t.term[0].toUpperCase()))];
---
<Base title="Glossary" description="Plain-language definitions of every key term in AP Microeconomics and AP Macroeconomics.">
  <PageBand eyebrow="Glossary" title="Glossary" lede={`${terms.length} terms, each defined in a sentence or two and linked to the unit where it comes up.`}>
    <div class="search">
      <label for="term-search" class="label">Search terms and definitions</label>
      <span class="search-box">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4" /><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
        <input id="term-search" class="input" type="search" autocomplete="off" spellcheck="false" placeholder="For example: elasticity" data-search />
      </span>
      <p class="hint" data-count aria-live="polite">Showing all {terms.length} terms.</p>
    </div>
  </PageBand>

  <div class="wrap">
    <nav class="letters" aria-label="Jump to letter">
      {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
    </nav>
    <div class="terms">
      {letters.map((l) => (
        <section class="letter-group" id={`letter-${l}`} data-group>
          <h2 class="letter">{l}</h2>
          <dl>
            {terms.filter((t) => t.term[0].toUpperCase() === l).map((t) => {
              const u = getUnit(t.unit)!;
              return (
                <div class="entry" id={termSlug(t.term)} data-entry data-text={`${t.term} ${t.def}`.toLowerCase()}>
                  <dt>{t.term}</dt>
                  <dd>
                    <p>{t.def}</p>
                    <a class:list={['entry-unit', `course-${u.course}`]} href={url(`/learn/${u.slug}/#term-${termSlug(t.term)}`)}><span class="entry-chip">{unitLabel(u)}</span>{u.title}</a>
                  </dd>
                </div>
              );
            })}
          </dl>
        </section>
      ))}
      <p class="empty" data-empty hidden>No terms match that search. Try a shorter word, like "cost" or "rate".</p>
    </div>
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-search]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const entries = document.querySelectorAll<HTMLElement>('[data-entry]');
  const groups = document.querySelectorAll<HTMLElement>('[data-group]');
  const total = entries.length;
  let timer = 0;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    entries.forEach((e) => {
      const match = !q || (e.dataset.text ?? '').includes(q);
      e.hidden = !match;
      if (match) shown++;
    });
    groups.forEach((g) => (g.hidden = !g.querySelector('[data-entry]:not([hidden])')));
    empty.hidden = shown > 0;
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      count.textContent = q ? `${shown} of ${total} terms match.` : `Showing all ${total} terms.`;
    }, 250);
  });
</script>

<style>
  .search {
    display: grid;
    gap: 0.45rem;
    max-width: 540px;
    margin-top: 0.75rem;
  }
  .search-box {
    position: relative;
    display: block;
  }
  .search-box svg {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-3);
    pointer-events: none;
  }
  .search-box .input {
    padding-left: 2.9rem;
  }
  .letters {
    position: sticky;
    top: 72px;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.85rem 0;
    background: var(--bg);
    border-bottom: 2px solid var(--line);
  }
  .letters a {
    display: inline-grid;
    place-items: center;
    min-width: 2.4rem;
    min-height: 2.4rem;
    border: 2px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    box-shadow: 0 3px 0 var(--line);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--ink);
    text-decoration: none;
  }
  .letters a:hover {
    border-color: var(--brand);
    color: var(--brand);
    box-shadow: 0 3px 0 var(--brand);
  }
  .letters a:active {
    transform: translateY(3px);
    box-shadow: none;
  }
  .terms {
    padding-bottom: 5rem;
  }
  .letter-group {
    display: grid;
    gap: 0.9rem;
    padding-top: 2.25rem;
    scroll-margin-top: 140px;
  }
  @media (min-width: 820px) {
    .letter-group {
      grid-template-columns: 72px 1fr;
      gap: 1.25rem;
      align-items: start;
    }
  }
  .letter-group[hidden],
  .entry[hidden] {
    display: none;
  }
  .letter {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 14px;
    background: var(--brand-fill);
    color: #fff;
    box-shadow: 0 4px 0 var(--brand-fill-lip);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
  }
  @media (min-width: 820px) {
    .letter {
      position: sticky;
      top: 150px;
    }
  }
  .letter-group dl {
    margin: 0;
    border: 2px solid var(--line);
    border-radius: 20px;
    background: var(--card);
    box-shadow: 0 4px 0 var(--line);
    overflow: hidden;
  }
  .entry {
    display: grid;
    gap: 0.4rem 2rem;
    padding: 1.1rem 1.35rem;
    scroll-margin-top: 150px;
  }
  .entry + .entry {
    border-top: 2px solid var(--line);
  }
  @media (min-width: 820px) {
    .entry {
      grid-template-columns: minmax(190px, 0.75fr) 2fr;
    }
  }
  .entry:target {
    background: var(--sun-tint);
  }
  .entry dt {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1.25;
  }
  .entry dd {
    margin: 0;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .entry dd p {
    font-size: 1.04rem;
    line-height: 1.55;
  }
  .entry-unit {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink-2);
    text-decoration: none;
  }
  .entry-unit:hover {
    color: var(--brand);
    text-decoration: underline;
  }
  .entry-chip {
    padding: 0.12rem 0.5rem;
    border-radius: 7px;
    font-size: 0.76rem;
    font-weight: 800;
    background: var(--brand-tint);
    color: var(--brand);
  }
  .course-micro .entry-chip {
    background: var(--orange-tint);
    color: var(--orange-text);
  }
  .course-both .entry-chip {
    background: var(--sun-tint);
    color: var(--fourth);
  }
  .empty {
    padding: 2rem 0;
    font-weight: 700;
  }
</style>
