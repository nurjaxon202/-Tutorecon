---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import { units } from '../data/units';
import { questions } from '../data/questions';
import { frqs } from '../data/frqs';
import { glossary } from '../data/glossary';
import { url } from '../lib/url';
import { site } from '../site';

const free = [
  `All ${units.length} lessons, covering every official topic in AP Micro and AP Macro`,
  `The full question bank: ${questions.length} questions with an explanation for every choice`,
  `All ${frqs.length} free-response questions with scoring guides`,
  `${glossary.length} flashcards, the glossary, and the graph lab`,
  'The score calculator and your progress, saved in your browser',
];
const pro = [
  'Everything in Free',
  'Timed mock exams: full length (60 questions, 70 minutes) or half length',
  'A score for each unit after every mock exam, and a history of past scores',
  'Printable one-page review sheets for every unit',
];
---
<Base title="Pricing" description="TutorEcon is free to learn from. Pro adds timed mock exams and printable review sheets for $5 a month.">
  <PageBand
    eyebrow="Pricing"
    title="Free to learn. Pro for exam prep."
    lede="Nothing in the lessons is locked. Pro is for the weeks before a test, when you want timed practice and something to print."
  />

  <div class="wrap pricing-body">
    <div class="notice notice-demo" role="note">
      <strong>Payments are not switched on.</strong>
      <span>The Pro checkout is a working demo. It only accepts a test card, never charges anyone, and keeps nothing you type.</span>
    </div>

    <div class="plans">
      <section class="plan" aria-labelledby="plan-free">
        <h2 id="plan-free" class="plan-name">Free</h2>
        <p class="plan-price"><span class="amount">$0</span></p>
        <p class="plan-for">For learning each unit and practicing as you go.</p>
        <ul class="plan-list">
          {free.map((f) => (
            <li>
              <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <a class="btn btn-secondary" href={url('/learn/')}>Start learning</a>
      </section>

      <section class="plan plan-pro on-board" aria-labelledby="plan-pro">
        <div class="plan-top">
          <h2 id="plan-pro" class="plan-name">Pro</h2>
          <span class="tag">Demo checkout</span>
        </div>
        <p class="plan-price"><span class="amount">${site.pro.price}</span><span class="per">per month</span></p>
        <p class="plan-for">For the run-up to the AP exam or a unit test.</p>
        <ul class="plan-list">
          {pro.map((f) => (
            <li>
              <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <a class="btn" href={url('/checkout/')} data-pro-cta>Try the Pro checkout</a>
        <p class="plan-note" data-pro-note hidden>Pro is already on in this browser. <a href={url('/account/')}>Manage it</a>.</p>
      </section>
    </div>

    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title" class="h2">Questions about Pro</h2>
      <dl class="faq-list">
        <div>
          <dt>Will I be charged anything?</dt>
          <dd>No. Payments are not switched on, and the checkout only accepts Stripe's public test card numbers. Real card numbers are rejected before anything happens.</dd>
        </div>
        <div>
          <dt>Where is my Pro status kept?</dt>
          <dd>Only in this browser's local storage, the same place your progress is saved. TutorEcon has no server and no accounts, so Pro does not follow you to another device.</dd>
        </div>
        <div>
          <dt>How do I cancel?</dt>
          <dd>Go to <a href={url('/account/')}>Your data and settings</a> and choose "Cancel Pro". Clearing your browser's site data also removes it.</dd>
        </div>
        <div>
          <dt>What happens if real payments are switched on?</dt>
          <dd>The pricing, terms, and refund policy will be updated first, and the checkout will be handled by a payment provider so that card details never touch this site.</dd>
        </div>
      </dl>
    </section>
  </div>
</Base>

<script>
  import { store } from '../scripts/store';
  if (store.isPro()) {
    document.querySelector<HTMLElement>('[data-pro-note]')!.hidden = false;
    const cta = document.querySelector<HTMLAnchorElement>('[data-pro-cta]');
    if (cta) cta.hidden = true;
  }
</script>

<style>
  .lede {
    max-width: 52ch;
  }
  .pricing-body {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .plans {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }
  @media (min-width: 820px) {
    .plans {
      grid-template-columns: 1fr 1fr;
      max-width: 1000px;
    }
  }
  .plan {
    display: grid;
    gap: 1rem;
    align-content: start;
    justify-items: start;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }
  .plan-pro {
    background: var(--bg);
    border-color: var(--line-strong);
    box-shadow: 0 5px 0 #070b16, var(--shadow-lg);
  }
  .plan-pro .amount {
    color: var(--sun);
  }
  .plan-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }
  .plan-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.7rem;
  }
  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .amount {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3.8rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .per {
    color: var(--ink-2);
    font-weight: 700;
  }
  .plan-for {
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .plan-list {
    list-style: none;
    margin: 0.25rem 0 0.75rem;
    padding: 1.1rem 0 0;
    display: grid;
    gap: 0.7rem;
    width: 100%;
    border-top: 1px solid var(--line);
  }
  .plan-list li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 0.7rem;
    align-items: start;
    font-weight: 600;
  }
  .plan-list svg {
    width: 22px;
    height: 22px;
    padding: 4px;
    border-radius: 50%;
    background: var(--good-fill);
    color: #fff;
  }
  .plan-pro .plan-list svg {
    background: var(--sun);
    color: #0b1220;
  }
  .plan .btn {
    width: 100%;
  }
  .plan-note {
    font-size: 0.95rem;
    color: var(--good);
    font-weight: 700;
  }
  .faq {
    max-width: 760px;
    padding-block: 4rem 5rem;
  }
  .faq-list {
    display: grid;
    margin: 1.25rem 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .faq-list div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .faq-list dt {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .faq-list dd {
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    max-width: 65ch;
  }
</style>
