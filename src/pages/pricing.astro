---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import { units } from '../data/units';
import { questions } from '../data/questions';
import { frqs } from '../data/frqs';
import { glossary } from '../data/glossary';
import { url } from '../lib/url';
import { site } from '../site';
import { accountsOn } from '../lib/accounts';

import { gated, GUEST_DAILY, TOPIC_PREVIEW } from '../lib/access';
import { allTopics } from '../data/ced';

// Each row: the feature, then what guests, free accounts, and Pro get.
// true is a check mark, false is a dash, and text is shown as written.
type Cell = boolean | string;
const rows: [string, Cell, Cell, Cell][] = [
  [`All ${units.length} lessons with graphs you can move`, true, true, true],
  [`A guide for each of the ${allTopics.length} official topics`, true, true, true],
  [`Free-response questions (${frqs.length}) with scoring guides`, true, true, true],
  [`${glossary.length} flashcards, the glossary, formula sheet, and graph lab`, true, true, true],
  ['Score calculator', true, true, true],
  ['Practice set on each topic page', `First ${TOPIC_PREVIEW}`, 'All', 'All'],
  [`Question bank of ${questions.length} questions`, `${GUEST_DAILY} a day`, 'Unlimited', 'Unlimited'],
  ['Tutor mode and timed exam mode', true, true, true],
  ['Progress saved', 'This browser', 'Every device', 'Every device'],
  ['Missed and flagged review', false, true, true],
  ['Smart review of the questions you miss', false, true, true],
  ['Weakest topics and unit mastery', false, true, true],
  ['Study planner and exam countdown', false, true, true],
  ['Timed mock exams with a score for each unit', false, false, true],
  ['Printable review sheets for every unit', false, false, true],
];
// Without accounts there is nothing to sign up for, so the free column is everything a guest can use.
const cols = gated ? ['No account', 'Free account', 'Pro'] : ['Free', 'Pro'];
const cellsFor = (r: (typeof rows)[number]): Cell[] => (gated ? [r[1], r[2], r[3]] : [r[2] === 'Every device' ? 'This browser' : r[2], r[3] === 'Every device' ? 'This browser' : r[3]]);
---
<Base title="Plans" description="Everything you need to learn AP Micro and AP Macro is free. A free account adds unlimited practice and progress tracking. Pro adds timed mock exams and printable review sheets.">
  <PageBand
    eyebrow="Plans"
    title="Free to learn. Pro for exam prep."
    lede={gated
      ? 'Start right away without an account. A free account unlocks unlimited practice and the tools that tell you what to study next. Pro is for the weeks before the exam.'
      : 'Nothing in the lessons is locked. Pro is for the weeks before a test, when you want timed practice and something to print.'}
  />

  <div class="wrap pricing-body">
    <div class="notice notice-demo" role="note">
      <strong>Payments are not switched on.</strong>
      <span>The Pro checkout is a working demo. It only accepts a test card, never charges anyone, and keeps nothing you type.</span>
    </div>

    <div class:list={['plans', { three: gated }]}>
      {gated && (
        <section class="plan" aria-labelledby="plan-guest">
          <h2 id="plan-guest" class="plan-name">No account</h2>
          <p class="plan-price"><span class="amount">$0</span></p>
          <p class="plan-for">Open any page and start. Nothing to fill in.</p>
          <ul class="plan-list">
            <li><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span>Every lesson and topic guide</span></li>
            <li><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span>{GUEST_DAILY} question-bank questions a day</span></li>
            <li><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span>Flashcards, FRQs, and every study tool</span></li>
          </ul>
          <a class="btn btn-secondary" href={url('/learn/')}>Start learning</a>
        </section>
      )}

      <section class:list={['plan', { 'plan-rec': gated }]} aria-labelledby="plan-free">
        <div class="plan-top">
          <h2 id="plan-free" class="plan-name">{gated ? 'Free account' : 'Free'}</h2>
          {gated && <span class="tag tag-good">Recommended</span>}
        </div>
        <p class="plan-price"><span class="amount">$0</span></p>
        <p class="plan-for">{gated ? 'For studying all year, with progress on every device.' : 'For learning each unit and practicing as you go.'}</p>
        <ul class="plan-list">
          {(gated
            ? ['Unlimited question bank and full topic sets', 'Smart review of every question you miss', 'Weakest topics, unit mastery, and a study plan', 'Progress on every device you sign in on']
            : [`All ${units.length} lessons and ${allTopics.length} topic guides`, `The full question bank: ${questions.length} questions`, 'Smart review, study planner, and dashboard', `${frqs.length} free-response questions and ${glossary.length} flashcards`]
          ).map((f) => (
            <li>
              <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        {gated ? (
          <>
            <a class="btn" href={url('/sign-up/')} data-guest-only>Create a free account</a>
            <a class="btn btn-secondary" href={url('/dashboard/')} data-member-only>Open your dashboard</a>
          </>
        ) : (
          <a class="btn btn-secondary" href={url('/learn/')}>Start learning</a>
        )}
      </section>

      <section class="plan plan-pro on-board" aria-labelledby="plan-pro">
        <div class="plan-top">
          <h2 id="plan-pro" class="plan-name">Pro</h2>
          <span class="tag">Demo checkout</span>
        </div>
        <p class="plan-price"><span class="amount">${site.pro.price}</span><span class="per">per month</span></p>
        <p class="plan-for">For the run-up to the AP exam or a unit test.</p>
        <ul class="plan-list">
          {['Everything in ' + (gated ? 'a free account' : 'Free'), 'Timed mock exams: 60 questions in 70 minutes, or half length', 'A score for each unit after every mock exam', 'Printable one-page review sheets for every unit'].map((f) => (
            <li>
              <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <a class="btn" href={url('/checkout/')} data-pro-cta>Try the Pro checkout</a>
        <p class="plan-note" data-pro-note hidden>Pro is already on in this browser. <a href={url('/account/')}>Manage it</a>.</p>
      </section>
    </div>

    <section class="compare" aria-labelledby="compare-title">
      <h2 id="compare-title" class="h2">Compare plans</h2>
      {!gated && <p class="muted">This copy of TutorEcon has no accounts switched on, so everything in the Free column is open to everyone without signing up.</p>}
      <div class="table-scroll">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              {cols.map((c) => <th scope="col">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r[0]}</th>
                {cellsFor(r).map((c) => (
                  <td>
                    {c === true ? (
                      <span class="yes"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span class="visually-hidden">Included</span></span>
                    ) : c === false ? (
                      <span class="no"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 8h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg><span class="visually-hidden">Not included</span></span>
                    ) : (
                      c
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title" class="h2">Questions about Pro</h2>
      <dl class="faq-list">
        <div>
          <dt>Will I be charged anything?</dt>
          <dd>No. Payments are not switched on, and the checkout only accepts Stripe's public test card numbers. Real card numbers are rejected before anything happens.</dd>
        </div>
        <div>
          <dt>Where is my Pro status kept?</dt>
          <dd>{accountsOn ? 'In this browser’s local storage, the same place your progress is saved. If you are signed in, it is saved to your account too, so it follows you to other devices.' : 'Only in this browser’s local storage, the same place your progress is saved. Accounts are not switched on, so Pro does not follow you to another device.'}</dd>
        </div>
        <div>
          <dt>How do I cancel?</dt>
          <dd>Go to <a href={url('/account/')}>Your data and settings</a> and choose "Cancel Pro". Clearing your browser's site data also removes it.</dd>
        </div>
        <div>
          <dt>What happens if real payments are switched on?</dt>
          <dd>The pricing, terms, and refund policy will be updated first, and the checkout will be handled by a payment provider so that card details never touch this site.</dd>
        </div>
      </dl>
    </section>
  </div>
</Base>

<script>
  import { store } from '../scripts/store';
  if (store.isPro()) {
    document.querySelector<HTMLElement>('[data-pro-note]')!.hidden = false;
    const cta = document.querySelector<HTMLAnchorElement>('[data-pro-cta]');
    if (cta) cta.hidden = true;
  }
</script>

<style>
  .lede {
    max-width: 52ch;
  }
  .pricing-body {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .plans {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }
  @media (min-width: 820px) {
    .plans {
      grid-template-columns: 1fr 1fr;
      max-width: 1000px;
    }
  }
  @media (min-width: 1080px) {
    .plans.three {
      grid-template-columns: 1fr 1fr 1fr;
      max-width: none;
    }
  }
  .plan-rec {
    border-color: var(--brand);
    box-shadow: 0 0 0 1px var(--brand), var(--shadow-lg);
  }
  .tag-good {
    background: var(--brand-tint);
    color: var(--brand);
  }
  .compare {
    display: grid;
    gap: 0.9rem;
    padding-top: 3.5rem;
  }
  .table-scroll {
    overflow-x: auto;
  }
  .compare-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
  }
  .compare-table th,
  .compare-table td {
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
  }
  .compare-table thead th {
    border-bottom: 2px solid var(--line-strong);
    font-size: 0.95rem;
  }
  .compare-table tbody th {
    font-weight: 500;
  }
  .compare-table td {
    width: 17%;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .yes {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--good-tint);
    color: var(--good);
  }
  .no {
    color: var(--ink-3);
  }
  .plan {
    display: grid;
    gap: 1rem;
    align-content: start;
    justify-items: start;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }
  .plan-pro {
    background: var(--bg);
    border-color: var(--line-strong);
    box-shadow: 0 5px 0 #070b16, var(--shadow-lg);
  }
  .plan-pro .amount {
    color: var(--sun);
  }
  .plan-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }
  .plan-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.7rem;
  }
  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .amount {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3.8rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .per {
    color: var(--ink-2);
    font-weight: 700;
  }
  .plan-for {
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .plan-list {
    list-style: none;
    margin: 0.25rem 0 0.75rem;
    padding: 1.1rem 0 0;
    display: grid;
    gap: 0.7rem;
    width: 100%;
    border-top: 1px solid var(--line);
  }
  .plan-list li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 0.7rem;
    align-items: start;
    font-weight: 600;
  }
  .plan-list svg {
    width: 22px;
    height: 22px;
    padding: 4px;
    border-radius: 50%;
    background: var(--good-fill);
    color: #fff;
  }
  .plan-pro .plan-list svg {
    background: var(--sun);
    color: #0b1220;
  }
  .plan .btn {
    width: 100%;
  }
  .plan-note {
    font-size: 0.95rem;
    color: var(--good);
    font-weight: 700;
  }
  .faq {
    max-width: 760px;
    padding-block: 4rem 5rem;
  }
  .faq-list {
    display: grid;
    margin: 1.25rem 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .faq-list div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .faq-list dt {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .faq-list dd {
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    max-width: 65ch;
  }
</style>
