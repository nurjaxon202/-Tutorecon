---
import AuthShell from '../components/AuthShell.astro';
import { url } from '../lib/url';
---
<AuthShell title="Reset your password" description="Get a link to choose a new TutorEcon password." lede="Enter the email you signed up with, and we will send a link to choose a new password." noindex>
  <form class="auth-form" novalidate data-forgot>
    <div class="field">
      <label for="fp-email">Email</label>
      <input id="fp-email" type="email" class="input" autocomplete="email" spellcheck="false" required aria-describedby="fp-email-error" aria-invalid="false" />
      <p id="fp-email-error" class="error-text" data-error="email"></p>
    </div>
    <p class="error-text form-error" role="alert" data-error="form"></p>
    <p class="form-note" role="status" data-note></p>
    <button type="submit" class="btn btn-big" data-submit>Send reset link</button>
    <p><a href={url('/sign-in/')}>Back to sign in</a></p>
  </form>
</AuthShell>

<script>
  import { accountsOn, authMessage, connect, siteLink } from '../scripts/account';
  import { busy, emailOk, fieldError } from '../scripts/forms';

  const form = document.querySelector<HTMLFormElement>('[data-forgot]');
  if (accountsOn && form) {
    const email = form.querySelector<HTMLInputElement>('#fp-email')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const note = form.querySelector<HTMLElement>('[data-note]')!;

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      fieldError(form, 'form', '');
      note.textContent = '';
      const e = email.value.trim();
      const msg = !e ? 'Enter your email address.' : emailOk(e) ? '' : 'Enter an email address like name@example.com.';
      fieldError(form, 'email', msg, email);
      if (msg) return email.focus();

      busy(submit, true, 'Sending link');
      try {
        const client = await connect();
        const { error } = await client.auth.resetPasswordForEmail(e, { redirectTo: siteLink('/reset-password/') });
        if (error) throw error;
        // The same message whether or not an account exists, so this form
        // cannot be used to find out who has signed up.
        note.textContent = `If an account uses ${e}, a reset link is on its way. Open it to choose a new password.`;
      } catch (err) {
        fieldError(form, 'form', authMessage(err));
      } finally {
        busy(submit, false, 'Send reset link');
      }
    });
  }
</script>
