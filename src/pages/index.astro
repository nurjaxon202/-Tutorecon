---
import Base from '../layouts/Base.astro';
import HeroDemo from '../components/HeroDemo.astro';
import { courses, examFormat, allTopics } from '../data/ced';
import { questions } from '../data/questions';
import { frqs } from '../data/frqs';
import { glossary } from '../data/glossary';
import { units } from '../data/units';
import { graphList } from '../scripts/graphs/models';
import { formulaGroups } from '../data/formulas';
import { url } from '../lib/url';
import { gated } from '../lib/access';

const tools = [
  { href: '/practice/', title: 'Question bank', count: `${questions.length} questions`, text: 'Multiple choice in the AP format, filtered by course, unit, official topic, and difficulty. Every choice explains itself.' },
  { href: '/frq/', title: 'Free-response questions', count: `${frqs.length} questions`, text: 'Long and short questions with point-by-point scoring guides, a timer, and a place to record your score.' },
  { href: '/flashcards/', title: 'Flashcards', count: `${glossary.length} terms`, text: 'Every key term from the lessons, sorted by unit. Cards you know drop out of the deck.' },
  { href: '/graph-lab/', title: 'Graph lab', count: `${graphList.length} graphs`, text: 'Drag the curves in every graph the exam asks you to draw, from supply and demand to the Phillips curve.' },
  { href: '/mock-exam/', title: 'Mock exam', count: 'Pro', text: 'A timed multiple-choice exam drawn from both courses, scored by unit at the end.' },
  { href: '/study-plan/', title: 'Study planner', count: 'Free', text: 'Enter your exam date and the days you can study. Get a day-by-day plan weighted by how much each unit counts.' },
  { href: '/formulas/', title: 'Formula sheet', count: `${formulaGroups.reduce((n, g) => n + g.items.length, 0)} formulas`, text: 'Every formula and decision rule from both courses on one printable page, most with a worked example.' },
  { href: '/score-calculator/', title: 'Score calculator', count: 'Free', text: 'Turn a practice test into a weighted score and see what each point is worth.' },
];
const titles = Object.fromEntries(units.map((u) => [u.slug, u.title]));
---
<Base>
  <section class="intro">
    <div class="wrap intro-grid">
      <div class="intro-text">
        <h1 class="display">Free AP Micro and AP Macro review, built around graphs you can move.</h1>
        <p class="lede">
          {`Lessons for all ${allTopics.length} official topics, ${questions.length} practice questions with an explanation for every choice, ${frqs.length} free-response questions with scoring guides, and ${glossary.length} flashcards. ${gated ? 'Start right away, no account needed.' : 'No account and no payment needed.'}`}
        </p>
        <div class="course-links">
          {courses.map((c) => (
            <a class:list={['course-link', `course-${c.id}`]} href={url(c.path)}>
              <span class="cl-name">{c.name}</span>
              <span class="cl-sub">{c.units.length} units · {c.units.reduce((n, u) => n + u.topics.length, 0)} topics</span>
            </a>
          ))}
        </div>
        <p class="start-note">
          Not sure where to start? Both courses open with <a href={url('/learn/foundations/')}>Unit 1: Basic economic concepts</a>.
        </p>
      </div>
      <div class="intro-demo">
        <h2 class="demo-title">Try a question</h2>
        <HeroDemo />
      </div>
    </div>
  </section>

  <section class="resume" data-resume hidden aria-labelledby="resume-title" data-base={url('/')}>
    <div class="wrap resume-inner">
      <h2 id="resume-title" class="resume-title">Pick up where you left off</h2>
      <ul class="resume-list" data-resume-list></ul>
    </div>
  </section>

  {gated && (
    <section class="join" data-guest-only aria-labelledby="join-title">
      <div class="wrap join-inner">
        <div class="join-text">
          <h2 id="join-title" class="join-title">Studying for the real exam? Make a free account.</h2>
          <p>Everything on this page works without one. An account adds unlimited practice, smart review of the questions you miss, your weakest topics, a study plan, and your progress on every device.</p>
        </div>
        <div class="btn-row">
          <a class="btn" href={url('/sign-up/')}>Create a free account</a>
          <a class="btn btn-secondary" href={url('/pricing/')}>Compare plans</a>
        </div>
      </div>
    </section>
  )}

  <section class="block" aria-labelledby="units-title">
    <div class="wrap">
      <div class="block-head">
        <h2 id="units-title" class="h2">Both courses, unit by unit</h2>
        <p class="muted">Units and weights follow the College Board course descriptions. The percentage is each unit’s share of the multiple-choice section.</p>
      </div>
      <div class="courses">
        {courses.map((c) => (
          <section class:list={['course', `course-${c.id}`]} aria-labelledby={`c-${c.id}`}>
            <h3 id={`c-${c.id}`} class="course-name"><a href={url(c.path)}>{c.name}</a></h3>
            <ol class="unit-list">
              {c.units.map((u) => (
                <li>
                  <a href={url(`${c.path}#unit-${u.n}`)}>
                    <span class="u-n">{u.n}</span>
                    <span class="u-title">{u.title}</span>
                    <span class="u-weight">{u.weight}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="block block-alt" aria-labelledby="tools-title">
    <div class="wrap">
      <div class="block-head">
        <h2 id="tools-title" class="h2">Practice the way the exam tests you</h2>
        <p class="muted">Everything is tagged with its official topic, so a wrong answer tells you exactly which lesson section to reread.</p>
      </div>
      <ul class="tools">
        {tools.map((t) => (
          <li>
            <a href={url(t.href)} class="tool">
              <span class="tool-top">
                <span class="tool-title">{t.title}</span>
                <span class="tool-count">{t.count}</span>
              </span>
              <span class="tool-text">{t.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block" aria-labelledby="exam-title">
    <div class="wrap exam">
      <div class="block-head">
        <h2 id="exam-title" class="h2">How the exam is built</h2>
        <p class="muted">AP Micro and AP Macro share the same format.</p>
      </div>
      <table class="exam-table">
        <thead>
          <tr><th scope="col">Section</th><th scope="col">Questions</th><th scope="col">Time</th><th scope="col">Share of score</th></tr>
        </thead>
        <tbody>
          {examFormat.sections.map((s) => (
            <tr><td>{s.name}</td><td>{s.detail}</td><td>{s.time}</td><td>{s.weight}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="exam-more">{examFormat.notes[0]} <a href={url('/score-calculator/')}>See what each point is worth</a>.</p>
    </div>
  </section>

  <script type="application/json" data-lesson-titles set:html={JSON.stringify(titles)} />
</Base>

<script>
  import { dayKey, store } from '../scripts/store';

  // A short list of next steps, once the reader has some history in this browser.
  const box = document.querySelector<HTMLElement>('[data-resume]')!;
  const list = document.querySelector<HTMLElement>('[data-resume-list]')!;
  const base = box.dataset.base!;
  const titles: Record<string, string> = JSON.parse(document.querySelector('[data-lesson-titles]')!.textContent!);
  const saved = store.get();
  const items: string[] = [];
  if (saved.plan && saved.plan.exam > dayKey()) items.push(`<li><a href="${base}study-plan/">See today in your study plan</a></li>`);
  const started = Object.entries(saved.steps).find(([slug, step]) => step > 0 && !saved.done[slug] && titles[slug]);
  if (started) items.push(`<li><a href="${base}learn/${started[0]}/">Continue the lesson: ${titles[started[0]]}</a></li>`);
  const missed = Object.values(saved.qstats).filter((s) => s.l === 0).length;
  if (missed) items.push(`<li><a href="${base}missed/">Review ${missed} question${missed === 1 ? '' : 's'} you missed last time</a></li>`);
  const answered = Object.keys(saved.qstats).length;
  if (answered && !missed) items.push(`<li><a href="${base}practice/?course=all&which=new">Try questions you have not seen yet (${answered} answered so far)</a></li>`);
  const frqCount = Object.keys(saved.frq).length;
  if (frqCount) items.push(`<li><a href="${base}frq/">Free-response: ${frqCount} scored so far</a></li>`);
  if (items.length) {
    list.innerHTML = items.join('');
    box.hidden = false;
  }
</script>

<style>
  .join {
    border-block: 1px solid var(--line);
    background: var(--brand-tint);
  }
  .join-inner {
    display: grid;
    gap: 1rem 2rem;
    align-items: center;
    padding-block: 1.5rem;
  }
  @media (min-width: 900px) {
    .join-inner {
      grid-template-columns: 1fr auto;
    }
  }
  .join-text {
    display: grid;
    gap: 0.4rem;
    max-width: 70ch;
  }
  .join-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .intro {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem) clamp(2.5rem, 1.5rem + 3vw, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .intro-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 1020px) {
    .intro-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
    }
  }
  .intro-text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .intro-text .display {
    max-width: 18ch;
  }
  .course-links {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  @media (min-width: 560px) {
    .course-links {
      grid-template-columns: 1fr 1fr;
    }
  }
  .course-link {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 1.1rem 0.9rem 1.25rem;
    border: 1px solid var(--line-strong);
    border-top: 4px solid var(--orange);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    color: var(--ink);
  }
  .course-link.course-macro {
    border-top-color: var(--brand);
  }
  .course-link:hover {
    background: var(--bg-2);
  }
  .course-link:hover .cl-name {
    text-decoration: underline;
  }
  .cl-name {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.2rem;
  }
  .cl-sub {
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .start-note {
    color: var(--ink-2);
  }
  .intro-demo {
    display: grid;
    gap: 0.75rem;
  }
  .demo-title {
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: 700;
  }
  .resume {
    background: var(--sun-tint);
    border-bottom: 1px solid var(--line);
  }
  .resume-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 2rem;
    padding-block: 1rem;
  }
  .resume-title {
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: 700;
  }
  .resume-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 500;
  }
  .block {
    padding-block: clamp(2.75rem, 2rem + 3vw, 4.5rem);
  }
  .block-alt {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }
  .block-head {
    display: grid;
    gap: 0.5rem;
    max-width: 62ch;
    margin-bottom: 1.75rem;
  }
  .courses {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .courses {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  .course-name {
    font-size: 1.35rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--orange);
  }
  .course-macro .course-name {
    border-bottom-color: var(--brand);
  }
  .course-name a {
    text-decoration: none;
  }
  .course-name a:hover {
    text-decoration: underline;
  }
  .unit-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .unit-list a {
    display: grid;
    grid-template-columns: 1.6rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.7rem 0.25rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .unit-list a:hover {
    background: var(--bg-2);
  }
  .unit-list a:hover .u-title {
    text-decoration: underline;
  }
  .u-n {
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
    font-weight: 600;
  }
  .u-title {
    font-weight: 500;
  }
  .u-weight {
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 860px) {
    .tools {
      grid-template-columns: 1fr 1fr;
      column-gap: 3rem;
    }
  }
  .tool {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--line-strong);
    text-decoration: none;
    color: var(--ink);
    height: 100%;
  }
  .tool:hover .tool-title {
    text-decoration: underline;
  }
  .tool-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .tool-title {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.2rem;
  }
  .tool-count {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .tool-text {
    color: var(--ink-2);
  }
  .exam-table {
    width: 100%;
    max-width: 900px;
    border-collapse: collapse;
  }
  .exam-table th,
  .exam-table td {
    text-align: left;
    padding: 0.7rem 0.5rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .exam-table th {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
    border-bottom-color: var(--line-strong);
  }
  .exam-table td:first-child {
    font-weight: 600;
  }
  .exam-table th:last-child,
  .exam-table td:last-child {
    white-space: nowrap;
  }
  .exam-more {
    margin-top: 1rem;
    max-width: 70ch;
    color: var(--ink-2);
  }
  @media (max-width: 640px) {
    .exam-table th:nth-child(3),
    .exam-table td:nth-child(3) {
      display: none;
    }
  }
</style>
