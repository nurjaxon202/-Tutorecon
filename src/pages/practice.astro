---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import Quiz from '../components/Quiz.astro';
import { questions, questionsFor } from '../data/questions';
import { units, unitLabel } from '../data/units';
import { url } from '../lib/url';
---
<Base title="Practice questions" description="Mixed AP Microeconomics and Macroeconomics practice questions, each with an explanation for every answer choice.">
  <PageBand
    eyebrow="Practice"
    title="Practice questions"
    lede={`Ten questions drawn at random from all ${questions.length}. Filter by course, check each answer as you go, and draw a new set whenever you like.`}
  />

  <div class="wrap practice-grid">
    <div class="practice-main">
      <Quiz questions={questions} saveAs="mixed" sample={10} title="Mixed review" intro="Each question shows which unit it comes from, so you know where to look if you miss it." />
    </div>

    <aside class="practice-side">
      <section class="panel side-card" aria-labelledby="by-unit">
        <h2 id="by-unit" class="h3">Practice by unit</h2>
        <ul>
          {units.map((u) => (
            <li>
              <a class:list={['side-link', `course-${u.course}`]} href={url(`/learn/${u.slug}/#practice`)} data-unit={u.slug}>
                <span class="side-n" aria-hidden="true">{u.apUnit}</span>
                <span class="side-text">
                  <span class="side-title">{u.title}</span>
                  <span class="side-label">{unitLabel(u)}</span>
                </span>
                <span class="side-score" data-score>{questionsFor(u.slug).length} Qs</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section class="panel side-card pro-card">
        <p class="eyebrow">Pro</p>
        <h2 class="h3">Ready for timed practice?</h2>
        <p class="muted">The mock exam gives you 20 questions and 25 minutes, then breaks your score down by unit.</p>
        <a class="btn btn-secondary btn-small" href={url('/mock-exam/')}>Open the mock exam</a>
      </section>
    </aside>
  </div>
</Base>

<script>
  import { store } from '../scripts/store';
  const sync = () => {
    const quiz = store.get().quiz;
    document.querySelectorAll<HTMLElement>('[data-unit]').forEach((a) => {
      const r = quiz[a.dataset.unit!];
      const el = a.querySelector<HTMLElement>('[data-score]');
      if (r && el) el.textContent = `Best ${r.best} of ${r.total}`;
    });
  };
  window.addEventListener('tutorecon:change', sync);
  sync();
</script>

<style>
  .lede {
    max-width: 56ch;
  }
  .practice-grid {
    display: grid;
    gap: 2.5rem;
    padding-top: 2.5rem;
    padding-bottom: 5rem;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .practice-grid {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 3rem;
    }
    .practice-side {
      position: sticky;
      top: 96px;
    }
  }
  .practice-side {
    display: grid;
    gap: 1.25rem;
  }
  .side-card {
    padding: 1.25rem;
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .side-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    display: grid;
    gap: 0.2rem;
  }
  .side-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem;
    margin: 0 -0.6rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .side-link:hover {
    background: var(--bg-2);
  }
  .side-link:hover .side-title {
    text-decoration: underline;
  }
  .side-n {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 10px;
    background: var(--brand-fill);
    color: #fff;
    box-shadow: 0 3px 0 var(--brand-fill-lip);
    font-family: var(--font-display);
    font-weight: 800;
  }
  .course-micro .side-n {
    background: var(--orange);
    color: #0b1220;
    box-shadow: 0 3px 0 var(--orange-lip);
  }
  .course-both .side-n {
    background: var(--sun);
    color: #0b1220;
    box-shadow: 0 3px 0 var(--sun-lip);
  }
  .side-text {
    display: grid;
    gap: 0.05rem;
    min-width: 0;
  }
  .side-title {
    font-weight: 800;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .side-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .side-score {
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--ink-2);
    white-space: nowrap;
  }
</style>
