---
import AuthShell from '../components/AuthShell.astro';
import { MIN_PASSWORD } from '../lib/accounts';
import { url } from '../lib/url';
---
<AuthShell title="Choose a new password" description="Set a new password for your TutorEcon account." noindex>
  <p class="muted" data-checking>Checking your reset link.</p>

  <div class="bad-link" data-bad hidden>
    <p><strong data-bad-reason>That link has expired or was already used.</strong> Reset links work once and only for a short time.</p>
    <a class="btn" href={url('/forgot-password/')}>Send a new link</a>
  </div>

  <form class="auth-form" novalidate data-reset hidden>
    <p>Signed in as <strong data-email></strong>. Choose a new password for this account.</p>
    <div class="field">
      <label for="rp-password">New password</label>
      <div class="pw">
        <input id="rp-password" type="password" class="input" autocomplete="new-password" required minlength={MIN_PASSWORD} aria-describedby="rp-password-hint rp-password-error" aria-invalid="false" />
        <button type="button" class="reveal" data-reveal aria-controls="rp-password" aria-pressed="false" aria-label="Show password">Show</button>
      </div>
      <p id="rp-password-hint" class="hint">At least {MIN_PASSWORD} characters.</p>
      <p id="rp-password-error" class="error-text" data-error="password"></p>
    </div>
    <p class="error-text form-error" role="alert" data-error="form"></p>
    <button type="submit" class="btn btn-big" data-submit>Save new password</button>
  </form>

  <div class="done" data-done hidden>
    <h2 class="h3" tabindex="-1" data-done-title>Password changed</h2>
    <p>You are signed in with your new password.</p>
    <a class="btn" href={url('/account/')}>Go to your account</a>
  </div>
</AuthShell>

<script>
  import { accountsOn, authMessage, connect, linkProblem, onAuth } from '../scripts/account';
  import { MIN_PASSWORD } from '../lib/accounts';
  import { busy, fieldError, wireReveal } from '../scripts/forms';

  const form = document.querySelector<HTMLFormElement>('[data-reset]');
  if (accountsOn && form) {
    const checking = document.querySelector<HTMLElement>('[data-checking]')!;
    const bad = document.querySelector<HTMLElement>('[data-bad]')!;
    const done = document.querySelector<HTMLElement>('[data-done]')!;
    const password = form.querySelector<HTMLInputElement>('#rp-password')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    wireReveal(form);

    const problem = linkProblem();
    let finished = false;
    const show = (signedIn: boolean, email = '') => {
      if (finished) return;
      checking.hidden = true;
      form.hidden = !signedIn;
      bad.hidden = signedIn;
      if (signedIn) form.querySelector('[data-email]')!.textContent = email;
      else if (problem) bad.querySelector('[data-bad-reason]')!.textContent = problem;
    };

    // The reset link signs the reader in, then lands here.
    connect()
      .then(() => onAuth((s) => show(Boolean(s), s?.user.email ?? '')))
      .catch(() => show(false));

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      fieldError(form, 'form', '');
      const msg = password.value.length >= MIN_PASSWORD ? '' : `Use at least ${MIN_PASSWORD} characters.`;
      fieldError(form, 'password', msg, password);
      if (msg) return password.focus();
      busy(submit, true, 'Saving');
      try {
        const client = await connect();
        const { error } = await client.auth.updateUser({ password: password.value });
        if (error) throw error;
        finished = true;
        form.hidden = true;
        done.hidden = false;
        done.querySelector<HTMLElement>('[data-done-title]')!.focus();
      } catch (err) {
        fieldError(form, 'form', authMessage(err));
      } finally {
        busy(submit, false, 'Save new password');
      }
    });
  }
</script>

<style>
  .bad-link,
  .done {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-2);
  }
  .done {
    background: var(--good-tint);
  }
  .done h2:focus {
    outline: none;
  }
</style>
