---
import Base from '../../layouts/Base.astro';
import PageBand from '../../components/PageBand.astro';
import { units } from '../../data/units';
import { questionsFor } from '../../data/questions';
import { courses } from '../../data/ced';
import { allLessons } from '../../lib/lessons';
import { url } from '../../lib/url';

const lessons = allLessons();
const homes = (slug: string) =>
  courses.flatMap((c) => c.units.filter((u) => u.lessons.includes(slug)).map((u) => `${c.short} Unit ${u.n}`)).join(' · ');
const rows = units.map((u) => {
  const l = lessons.find((x) => x.unit.slug === u.slug)!;
  return { slug: u.slug, title: u.title, summary: u.summary, homes: homes(u.slug), minutes: l.minutes, sections: l.headings.length, graphs: l.graphs.length, questions: questionsFor(u.slug).length };
});
const groups = [
  { title: 'Shared by both courses', list: rows.filter((r) => units.find((u) => u.slug === r.slug)!.course === 'both') },
  { title: 'AP Microeconomics', list: rows.filter((r) => units.find((u) => u.slug === r.slug)!.course === 'micro') },
  { title: 'AP Macroeconomics', list: rows.filter((r) => units.find((u) => u.slug === r.slug)!.course === 'macro') },
];
---
<Base title="All lessons" description="Every TutorEcon lesson for AP Microeconomics and AP Macroeconomics, in course order, with your progress.">
  <PageBand
    eyebrow="Lessons"
    title="All lessons"
    lede={`${units.length} lessons in course order. Basic economic concepts opens both courses, and the supply and demand lesson also covers AP Macro Unit 1. Your progress is saved in this browser.`}
  >
    <p class="summary" data-summary hidden></p>
  </PageBand>

  <div class="wrap list">
    {groups.map((g) => (
      <section class="group" aria-labelledby={`g-${g.title}`}>
        <h2 id={`g-${g.title}`} class="h3">{g.title}</h2>
        <ol class="lessons">
          {g.list.map((r) => (
            <li class="lesson" data-lesson={r.slug} data-sections={r.sections}>
              <div class="l-main">
                <a class="l-title" href={url(`/learn/${r.slug}/`)}>{r.title}</a>
                <p class="l-sub">{r.homes}</p>
                <p class="l-sum">{r.summary}</p>
              </div>
              <p class="l-meta">
                {r.minutes} min · {r.sections} sections{r.graphs > 0 ? ` · ${r.graphs} graph${r.graphs === 1 ? '' : 's'}` : ''} · {r.questions} questions
              </p>
              <p class="l-state" data-state>Not started</p>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<script>
  import { store } from '../../scripts/store';
  const sync = () => {
    const saved = store.get();
    let done = 0;
    document.querySelectorAll<HTMLElement>('[data-lesson]').forEach((li) => {
      const slug = li.dataset.lesson!;
      const total = Number(li.dataset.sections);
      const step = Math.min(saved.steps[slug] ?? 0, total);
      const state = li.querySelector<HTMLElement>('[data-state]')!;
      li.classList.remove('is-done', 'is-started');
      if (saved.done[slug]) {
        done++;
        state.textContent = 'Done';
        li.classList.add('is-done');
      } else if (step > 0) {
        state.textContent = step >= total ? 'Read, check left' : `Section ${step + 1} of ${total}`;
        li.classList.add('is-started');
      } else state.textContent = 'Not started';
    });
    const box = document.querySelector<HTMLElement>('[data-summary]')!;
    const streak = store.currentStreak();
    box.hidden = !done && !saved.xp;
    box.textContent = `${done} of ${document.querySelectorAll('[data-lesson]').length} lessons done · ${saved.xp} XP · ${streak ? `${streak} day streak` : 'no streak running'} · ${store.todayXp()} XP today`;
  };
  window.addEventListener('tutorecon:change', sync);
  sync();
</script>

<style>
  .summary {
    font-weight: 600;
    color: var(--ink-2);
  }
  .list {
    display: grid;
    gap: 2.5rem;
    padding-top: 2rem;
    padding-bottom: 5rem;
    max-width: 1000px;
    margin-left: 0;
  }
  @media (min-width: 1100px) {
    .list {
      margin-left: auto;
      margin-right: auto;
      max-width: 1200px;
    }
  }
  .group {
    display: grid;
    gap: 0.75rem;
  }
  .lessons {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }
  .lesson {
    display: grid;
    gap: 0.35rem 2rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 860px) {
    .lesson {
      grid-template-columns: minmax(0, 1fr) auto 9rem;
      align-items: baseline;
    }
  }
  .l-main {
    display: grid;
    gap: 0.2rem;
  }
  .l-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 650;
    text-decoration: none;
  }
  .l-title:hover {
    text-decoration: underline;
  }
  .l-sub {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .l-sum {
    color: var(--ink-2);
    max-width: 62ch;
  }
  .l-meta {
    font-size: 0.92rem;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .l-state {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .is-started .l-state {
    color: var(--fourth);
  }
  .is-done .l-state {
    color: var(--good);
  }
  @media (max-width: 859px) {
    .l-meta {
      white-space: normal;
    }
  }
</style>
