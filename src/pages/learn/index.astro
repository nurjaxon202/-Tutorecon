---
import Base from '../../layouts/Base.astro';
import PageBand from '../../components/PageBand.astro';
import UnitTile from '../../components/UnitTile.astro';
import { units } from '../../data/units';
import { questionsFor } from '../../data/questions';
import { allLessons } from '../../lib/lessons';

const lessons = allLessons();
const metaFor = (slug: string) => {
  const l = lessons.find((x) => x.unit.slug === slug)!;
  return `${l.minutes} min · ${l.graphs.length} graph${l.graphs.length === 1 ? '' : 's'} · ${questionsFor(slug).length} questions`;
};
const foundations = units.find((u) => u.course === 'both')!;
const groups = [
  { title: 'AP Microeconomics', note: 'How individual markets, firms, and consumers make choices.', list: units.filter((u) => u.course === 'micro') },
  { title: 'AP Macroeconomics', note: 'Output, jobs, prices, money, and trade for the whole economy.', list: units.filter((u) => u.course === 'macro') },
];
---
<Base title="All units" description="Every TutorEcon unit for AP Microeconomics and AP Macroeconomics, with live graphs and practice questions.">
  <PageBand
    eyebrow="Units"
    title="Eleven units, in AP order"
    lede="Start with Unit 1, which both AP courses share. Each card shows your progress once you mark a unit done or finish its questions."
  >
    <div class="progress" data-overall hidden>
      <div class="progress-bar" aria-hidden="true"><span data-overall-bar></span></div>
      <p class="mono" data-overall-text></p>
    </div>
  </PageBand>

  <div class="wrap body">
    <section aria-labelledby="start-title">
      <h2 id="start-title" class="group-title">Start here</h2>
      <UnitTile unit={foundations} meta={metaFor(foundations.slug)} wide />
    </section>

    {groups.map((g) => (
      <section class="group" aria-labelledby={`g-${g.title}`}>
        <div class="group-head">
          <h2 id={`g-${g.title}`} class="group-title">{g.title}</h2>
          <p class="muted">{g.note}</p>
        </div>
        <ul class="tiles">
          {g.list.map((u) => (
            <li><UnitTile unit={u} meta={metaFor(u.slug)} summary /></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<script>
  import { store } from '../../scripts/store';
  const total = document.querySelectorAll('.tile[data-unit]').length;
  const sync = () => {
    const saved = store.get();
    const done = Object.keys(saved.done).length;
    const box = document.querySelector<HTMLElement>('[data-overall]');
    if (!box) return;
    box.hidden = done === 0 && Object.keys(saved.quiz).length === 0;
    document.querySelector<HTMLElement>('[data-overall-bar]')!.style.width = `${(done / total) * 100}%`;
    document.querySelector<HTMLElement>('[data-overall-text]')!.textContent = `${done} of ${total} units done`;
  };
  window.addEventListener('tutorecon:change', sync);
  sync();
</script>

<style>
  .progress {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    max-width: 420px;
  }
  .progress-bar {
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background: rgba(243, 246, 240, 0.15);
    overflow: hidden;
  }
  .progress-bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--hl);
    border-radius: 4px;
  }
  .progress p {
    font-size: 0.82rem;
    color: var(--chalk-2);
    white-space: nowrap;
  }
  .body {
    display: grid;
    gap: 3.5rem;
    padding-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-bottom: 5rem;
  }
  .group-title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 0.9rem;
  }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 2rem;
  }
  .group-head .muted {
    margin-bottom: 0.9rem;
  }
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
</style>
