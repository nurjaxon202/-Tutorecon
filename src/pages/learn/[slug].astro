---
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz.astro';
import { units, unitLabel } from '../../data/units';
import { questionsFor } from '../../data/questions';
import { termsFor, termSlug } from '../../data/glossary';
import { lesson } from '../../lib/lessons';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return units.map((u) => ({ params: { slug: u.slug } }));
}

const { slug } = Astro.params;
const unit = units.find((u) => u.slug === slug)!;
const { Content, headings, minutes, graphs, worked } = lesson(slug!);
const qs = questionsFor(slug!);
const terms = termsFor(slug!);
const i = units.indexOf(unit);
const prev = units[i - 1];
const next = units[i + 1];
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---
<Base title={unit.title} description={unit.summary}>
  <header class="wrap lesson-top">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={url('/learn/')}>All units</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{unitLabel(unit)}</span>
    </nav>
    <h1 class="page-title">{unit.title}</h1>
    <p class="lede">{unit.summary}</p>
    <ul class="lesson-meta mono">
      <li>About {minutes} min</li>
      {graphs.length > 0 && <li>{plural(graphs.length, 'interactive graph')}</li>}
      {worked > 0 && <li>{plural(worked, 'worked problem')}</li>}
      <li>{plural(qs.length, 'practice question')}</li>
    </ul>
  </header>

  <div class="wrap lesson-grid">
    <aside class="lesson-toc">
      <nav aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ol>
          {headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          <li><a href="#key-terms">Key terms</a></li>
          <li><a href="#practice">Practice questions</a></li>
        </ol>
        <p class="toc-status" data-status hidden></p>
      </nav>
    </aside>

    <article class="lesson-body">
      <div class="prose lesson-prose">
        <Content />
      </div>

      <section id="key-terms" class="terms" aria-labelledby="key-terms-title">
        <h2 id="key-terms-title" class="h2">Key terms</h2>
        <dl>
          {terms.map((t) => (
            <div class="term" id={`term-${termSlug(t.term)}`}>
              <dt>{t.term}</dt>
              <dd>{t.def}</dd>
            </div>
          ))}
        </dl>
        <p class="muted small">Every term from every unit is in the <a href={url('/glossary/')}>glossary</a>.</p>
      </section>

      <div id="practice" class="practice">
        <Quiz questions={qs} saveAs={slug!} />
      </div>

      <div class="done-row">
        <button type="button" class="btn" data-done aria-pressed="false">Mark this unit as done</button>
        <p class="muted small">Progress is saved in this browser only. <a href={url('/account/')}>Manage your data</a>.</p>
      </div>

      <nav class="pager" aria-label="Units">
        {prev ? (
          <a class="pager-link" href={url(`/learn/${prev.slug}/`)}>
            <span class="eyebrow">Previous · {unitLabel(prev)}</span>
            <span class="pager-title">{prev.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a class="pager-link pager-next" href={url(`/learn/${next.slug}/`)}>
            <span class="eyebrow">Next · {unitLabel(next)}</span>
            <span class="pager-title">{next.title}</span>
          </a>
        )}
      </nav>
    </article>
  </div>
</Base>

<script>
  import { store } from '../../scripts/store';

  const slug = location.pathname.split('/').filter(Boolean).pop() ?? '';
  const btn = document.querySelector<HTMLButtonElement>('[data-done]');
  const status = document.querySelector<HTMLElement>('[data-status]');

  const sync = () => {
    const done = store.isDone(slug);
    if (btn) {
      btn.setAttribute('aria-pressed', String(done));
      btn.textContent = done ? 'Done. Mark as not done' : 'Mark this unit as done';
      btn.classList.toggle('btn-secondary', done);
    }
    const quiz = store.get().quiz[slug];
    const bits = [];
    if (done) bits.push('Unit done');
    if (quiz) bits.push(`Best quiz score ${quiz.best} of ${quiz.total}`);
    if (status) {
      status.hidden = bits.length === 0;
      status.textContent = bits.join(' · ');
    }
  };
  btn?.addEventListener('click', () => {
    store.setDone(slug, !store.isDone(slug));
    sync();
  });
  window.addEventListener('tutorecon:change', sync);
  sync();

  // Highlight the section being read in the table of contents.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.lesson-toc a').forEach((a) => links.set(a.hash.slice(1), a));
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(e.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '0px 0px -70% 0px' },
  );
  targets.forEach((t) => observer.observe(t));
</script>

<style>
  .lesson-top {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-bottom: 2rem;
    display: grid;
    gap: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .crumbs a {
    color: var(--ink);
  }
  .lede {
    max-width: 58ch;
  }
  .lesson-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .lesson-meta li + li::before {
    content: '';
  }
  .lesson-grid {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  @media (min-width: 1040px) {
    .lesson-grid {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 3.5rem;
    }
  }
  .lesson-toc nav {
    position: sticky;
    top: 1.5rem;
    display: grid;
    gap: 0.6rem;
  }
  .lesson-toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.1rem;
    border-left: 1px solid var(--rule);
  }
  .lesson-toc a {
    display: block;
    padding: 0.35rem 0 0.35rem 0.85rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .lesson-toc a:hover {
    color: var(--ink);
  }
  .lesson-toc a[aria-current] {
    color: var(--ink);
    font-weight: 620;
    border-left-color: var(--ink);
  }
  .toc-status {
    font-size: 0.85rem;
    color: var(--good);
    font-weight: 600;
  }
  @media (max-width: 1039px) {
    .lesson-toc nav {
      position: static;
      padding: 1rem;
      border: 1px solid var(--rule);
      border-radius: var(--radius-lg);
      background: var(--paper-raised);
    }
  }
  .lesson-body {
    min-width: 0;
    max-width: 860px;
  }
  .lesson-prose {
    max-width: none;
  }
  .lesson-prose > :global(p),
  .lesson-prose > :global(ul),
  .lesson-prose > :global(ol),
  .lesson-prose > :global(h2),
  .lesson-prose > :global(h3) {
    max-width: 68ch;
  }
  .lesson-prose > :global(h2:first-child) {
    margin-top: 0;
  }
  .terms {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .terms dl {
    display: grid;
    gap: 0;
    margin: 1.25rem 0 1rem;
  }
  @media (min-width: 720px) {
    .terms dl {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
  }
  .term {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .term dt {
    font-weight: 700;
  }
  .term dd {
    margin: 0.2rem 0 0;
    color: var(--ink-2);
    font-family: var(--font-body);
    line-height: 1.5;
  }
  .small {
    font-size: 0.9rem;
  }
  .practice {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .done-row {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
  }
  .pager {
    margin-top: 3rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pager-link {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    text-decoration: none;
  }
  .pager-link:hover {
    border-color: var(--ink);
  }
  .pager-next {
    text-align: right;
  }
  .pager-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.25;
  }
</style>
