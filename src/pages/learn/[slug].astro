---
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz.astro';
import GraphThumb from '../../components/GraphThumb.astro';
import { units, unitLabel, courseName } from '../../data/units';
import { questionsFor } from '../../data/questions';
import { termsFor, termSlug } from '../../data/glossary';
import { unitThumb } from '../../data/thumbs';
import { shortTitle } from '../../data/short';
import { lesson } from '../../lib/lessons';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return units.map((u) => ({ params: { slug: u.slug } }));
}

const { slug } = Astro.params;
const unit = units.find((u) => u.slug === slug)!;
const { Content, headings, minutes, graphs, worked } = lesson(slug!);
const qs = questionsFor(slug!);
const terms = termsFor(slug!);
const i = units.indexOf(unit);
const prev = units[i - 1];
const next = units[i + 1];
const thumb = unitThumb[slug!];
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---
<Base title={unit.title} description={unit.summary}>
  <section class:list={['lesson-hero', `course-${unit.course}`]}>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={url('/learn/')}>All units</a>
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span aria-current="page">{unitLabel(unit)}</span>
        </nav>
        <div class="title-row">
          <span class="unit-badge" aria-hidden="true">{unit.apUnit}</span>
          <div>
            <p class="course">{courseName[unit.course]}</p>
            <h1 class="page-title">{unit.title}</h1>
          </div>
        </div>
        <p class="lede">{unit.summary}</p>
        <ul class="meta">
          <li><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="2" /><path d="M10 5.5V10l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>{minutes} min</li>
          <li>{plural(headings.length, 'step')}</li>
          {graphs.length > 0 && <li>{plural(graphs.length, 'live graph')}</li>}
          {worked > 0 && <li>{plural(worked, 'worked problem')}</li>}
          <li>{plural(qs.length, 'question')}</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn-big" href="#lesson" data-start>Start lesson <span class="arrow" aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <GraphThumb model={thumb.model} state={thumb.state} width={440} height={300} />
      </div>
    </div>
  </section>

  <div class="lesson-bar">
    <div class="wrap bar-inner">
      <p class="bar-unit"><span class="bar-n">{unit.apUnit}</span><span class="bar-name">{shortTitle[unit.slug]}</span></p>
      <div class="bar-track" role="progressbar" aria-label="Lesson progress" aria-valuemin="0" aria-valuemax={headings.length} aria-valuenow="0" data-progress-wrap>
        <span data-progress></span>
      </div>
      <p class="bar-count" data-count>0 of {headings.length}</p>
      <details class="bar-toc" data-toc>
        <summary aria-label="Jump to a section">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
          <span class="toc-label">Sections</span>
        </summary>
        <div class="toc-panel">
          <ol>
            {headings.map((h, n) => <li><a href={`#${h.slug}`} data-toc-link data-step-index={n}><span>{n + 1}</span>{h.text}</a></li>)}
            <li><a href="#unit-check" data-toc-link data-step-index={headings.length}><span>&check;</span>Unit check</a></li>
          </ol>
          <button type="button" class="btn btn-secondary btn-small" data-mode-toggle>Show the whole lesson</button>
        </div>
      </details>
    </div>
  </div>

  <div class="wrap">
    <article class="lesson" id="lesson" style={`--unit-n: '${unit.apUnit}'`} data-lesson={slug} data-steps={headings.length}>
      <div class="prose lesson-prose" data-prose>
        <Content />
      </div>

      <div class="unit-check" id="unit-check" data-unit-check>
        <section id="key-terms" class="terms" aria-labelledby="key-terms-title">
          <p class="eyebrow">Unit {unit.apUnit} vocabulary</p>
          <h2 id="key-terms-title" class="h2" tabindex="-1">Key terms</h2>
          <dl>
            {terms.map((t) => (
              <div class="term" id={`term-${termSlug(t.term)}`}>
                <dt>{t.term}</dt>
                <dd>{t.def}</dd>
              </div>
            ))}
          </dl>
          <p class="muted small">Every term from every unit is in the <a href={url('/glossary/')}>glossary</a>.</p>
        </section>

        <div id="practice" class="practice">
          <Quiz
            questions={qs}
            saveAs={slug!}
            unitCheck
            eyebrow="Unit check"
            title="Show what you know"
            intro={`Answer ${qs.length === 1 ? 'the question' : `all ${qs.length} questions`} to finish the unit. Every choice has its own explanation, and each first correct answer earns 10 XP.`}
          />
        </div>

        <div class="done-row">
          <p class="muted small">Progress is saved in this browser only. <a href={url('/account/')}>Manage your data</a>.</p>
          <button type="button" class="btn btn-secondary btn-small" data-done aria-pressed="false">Mark this unit as done</button>
        </div>
      </div>

      <nav class="pager" aria-label="Units">
        {prev ? (
          <a class="pager-link" href={url(`/learn/${prev.slug}/`)}>
            <span class="pager-dir">&larr; Previous</span>
            <span class="pager-title">{prev.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a class="pager-link pager-next" href={url(`/learn/${next.slug}/`)}>
            <span class="pager-dir">Next unit &rarr;</span>
            <span class="pager-title">{next.title}</span>
          </a>
        )}
      </nav>
    </article>
  </div>
</Base>

<script>
  import { store, LESSON_MODE_KEY } from '../../scripts/store';

  const article = document.querySelector<HTMLElement>('[data-lesson]')!;
  const slug = article.dataset.lesson!;
  const total = Number(article.dataset.steps);
  const prose = document.querySelector<HTMLElement>('[data-prose]')!;
  const check = document.querySelector<HTMLElement>('[data-unit-check]')!;
  const bar = document.querySelector<HTMLElement>('[data-progress]')!;
  const barWrap = document.querySelector<HTMLElement>('[data-progress-wrap]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
  const modeBtn = document.querySelector<HTMLButtonElement>('[data-mode-toggle]')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Group the lesson into steps, one per section heading.
  const steps: HTMLElement[] = [];
  let current: HTMLElement | null = null;
  for (const node of Array.from(prose.childNodes)) {
    if (node instanceof HTMLElement && node.tagName === 'H2') {
      current = document.createElement('section');
      current.className = 'lstep';
      current.dataset.step = String(steps.length);
      steps.push(current);
      prose.appendChild(current);
    }
    if (current) current.appendChild(node);
  }

  // A Continue button at the end of each step.
  steps.forEach((step, n) => {
    const nextTitle = n + 1 < steps.length ? steps[n + 1].querySelector('h2')?.textContent : 'Unit check';
    const wrap = document.createElement('div');
    wrap.className = 'lstep-next';
    wrap.innerHTML = `<button type="button" class="btn btn-big">Continue</button><p>Next: ${nextTitle ?? ''}</p>`;
    wrap.querySelector('button')!.addEventListener('click', () => reveal(n + 1, true));
    step.appendChild(wrap);
    step.querySelector('h2')?.setAttribute('tabindex', '-1');
  });

  let mode = (() => {
    try {
      return localStorage.getItem(LESSON_MODE_KEY) === 'all' ? 'all' : 'steps';
    } catch {
      return 'steps';
    }
  })();
  let shown = Math.min(store.getStep(slug), total);

  const paint = () => {
    const all = mode === 'all';
    article.classList.toggle('mode-all', all);
    steps.forEach((s, n) => {
      s.hidden = !all && n > shown;
      s.classList.toggle('is-current', !all && n === shown);
    });
    check.hidden = !all && shown < total;
    const done = all ? total : Math.min(shown, total);
    bar.style.transform = `scaleX(${total ? done / total : 1})`;
    barWrap.setAttribute('aria-valuenow', String(done));
    count.textContent = `${done} of ${total}`;
    modeBtn.textContent = all ? 'Go step by step' : 'Show the whole lesson';
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
      const idx = Number(a.dataset.stepIndex);
      a.classList.toggle('is-done', idx < done);
      a.classList.toggle('is-locked', !all && idx > shown);
    });
  };

  const reveal = (n: number, focus: boolean) => {
    shown = Math.max(shown, Math.min(n, total));
    store.setStep(slug, shown);
    paint();
    const target = n >= total ? check : steps[n];
    if (focus && target) {
      const heading = target.querySelector<HTMLElement>('h2') ?? target;
      heading.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
      heading.focus({ preventScroll: true });
    }
  };

  modeBtn.addEventListener('click', () => {
    mode = mode === 'all' ? 'steps' : 'all';
    try {
      localStorage.setItem(LESSON_MODE_KEY, mode);
    } catch {
      /* the choice lasts for this visit */
    }
    paint();
    if (toc) toc.open = false;
  });

  // Jumping to a section from the menu reveals everything up to it.
  document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const idx = Number(a.dataset.stepIndex);
      if (mode === 'steps' && idx > shown) {
        e.preventDefault();
        reveal(idx, true);
      }
      if (toc) toc.open = false;
    });
  });
  document.addEventListener('click', (e) => {
    if (toc?.open && !toc.contains(e.target as Node)) toc.open = false;
  });

  // A link to a later section (like #practice) opens the lesson up to it.
  const openFromHash = () => {
    const id = location.hash.slice(1);
    if (!id) return;
    const el = document.getElementById(id);
    if (!el) return;
    if (check.contains(el)) reveal(total, false);
    else {
      const step = el.closest<HTMLElement>('.lstep');
      if (step) reveal(Number(step.dataset.step), false);
    }
    el.scrollIntoView();
  };
  window.addEventListener('hashchange', openFromHash);

  document.querySelector('[data-start]')?.addEventListener('click', (e) => {
    e.preventDefault();
    const behavior: ScrollBehavior = reduce.matches ? 'auto' : 'smooth';
    if (shown === 0) {
      // Line the progress bar up under the site header, with the first step right below it.
      const header = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0;
      const barHeight = document.querySelector<HTMLElement>('.lesson-bar')?.offsetHeight ?? 0;
      window.scrollTo({ top: article.getBoundingClientRect().top + window.scrollY - header - barHeight, behavior });
      steps[0]?.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
      return;
    }
    const step = shown >= total ? check : steps[shown];
    const target = step?.querySelector<HTMLElement>('h2') ?? article;
    target.scrollIntoView({ behavior, block: 'start' });
  });

  paint();
  openFromHash();

  // Done button
  const btn = document.querySelector<HTMLButtonElement>('[data-done]');
  const sync = () => {
    const done = store.isDone(slug);
    if (btn) {
      btn.setAttribute('aria-pressed', String(done));
      btn.textContent = done ? 'Done. Mark as not done' : 'Mark this unit as done';
    }
  };
  btn?.addEventListener('click', () => {
    store.setDone(slug, !store.isDone(slug));
    sync();
  });
  window.addEventListener('tutorecon:change', sync);
  sync();

  // Margin definitions: on small screens a button shows them under the line.
  document.querySelectorAll<HTMLButtonElement>('.sn-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') === 'true';
      b.setAttribute('aria-expanded', String(!open));
      b.closest('.sn')?.classList.toggle('is-open', !open);
    });
  });
</script>

<style>
  /* Hero */
  .lesson-hero {
    --accent: var(--brand-fill);
    --accent-lip: var(--brand-fill-lip);
    --accent-ink: #fff;
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem);
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--accent) 16%, transparent) 1px, transparent 0) 0 0 / 22px 22px,
      linear-gradient(180deg, color-mix(in srgb, var(--accent) 9%, var(--bg)), var(--bg));
    border-bottom: 2px solid var(--line);
  }
  .course-micro {
    --accent: var(--orange);
    --accent-lip: var(--orange-lip);
    --accent-ink: #0b1220;
  }
  .course-both {
    --accent: var(--sun);
    --accent-lip: var(--sun-lip);
    --accent-ink: #0b1220;
  }
  .hero-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .hero-text {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink-3);
  }
  .crumbs a {
    color: var(--brand);
    text-decoration: none;
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.5rem + 1.5vw, 1.4rem);
  }
  .unit-badge {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(64px, 50px + 3vw, 86px);
    height: clamp(64px, 50px + 3vw, 86px);
    border-radius: 22px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 1.5rem + 1.5vw, 2.8rem);
    box-shadow: 0 6px 0 var(--accent-lip);
  }
  .course {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.25rem;
  }
  .lede {
    max-width: 54ch;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: 10px;
    background: var(--card);
    border: 2px solid var(--line);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink-2);
  }
  .hero-art {
    display: none;
  }
  @media (min-width: 1000px) {
    .hero-art {
      display: block;
      padding: 1.2rem;
      border-radius: var(--radius-lg);
      background: var(--card);
      border: 2px solid var(--line);
      box-shadow: var(--shadow-lg);
    }
  }
  .hero-art :global(.g-grid),
  .hero-art :global(.g-grid-major) {
    display: none;
  }

  /* Sticky lesson bar, under the site header */
  .lesson-bar {
    position: sticky;
    top: 72px;
    z-index: 30;
    background: var(--bg);
    border-bottom: 2px solid var(--line);
  }
  .bar-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 62px;
  }
  .bar-unit {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 800;
    white-space: nowrap;
  }
  .bar-n {
    display: inline-grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 9px;
    background: var(--brand-fill);
    color: #fff;
    font-size: 0.9rem;
  }
  .bar-track {
    flex: 1;
    height: 16px;
    border-radius: 8px;
    background: var(--line);
    overflow: hidden;
  }
  .bar-track span {
    display: block;
    height: 100%;
    border-radius: 8px;
    background: var(--good-fill);
    background-image: linear-gradient(transparent 22%, rgba(255, 255, 255, 0.35) 22%, rgba(255, 255, 255, 0.35) 44%, transparent 44%);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.6s cubic-bezier(0.3, 0.9, 0.3, 1.1);
  }
  .bar-count {
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .bar-toc {
    position: relative;
  }
  .bar-toc summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 42px;
    padding: 0.35rem 0.75rem;
    border-radius: 12px;
    border: 2px solid var(--line-strong);
    background: var(--card);
    box-shadow: 0 3px 0 var(--line-strong);
    font-weight: 800;
    font-size: 0.92rem;
    cursor: pointer;
    list-style: none;
  }
  .bar-toc summary::-webkit-details-marker {
    display: none;
  }
  .toc-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: min(380px, calc(100vw - 2 * var(--gutter)));
    padding: 0.6rem;
    display: grid;
    gap: 0.6rem;
    background: var(--card);
    border: 2px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .toc-panel ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .toc-panel a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    color: var(--ink-2);
    line-height: 1.3;
  }
  .toc-panel a:hover {
    background: var(--bg-2);
    color: var(--ink);
  }
  .toc-panel a span {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 8px;
    border: 2px solid var(--line-strong);
    font-size: 0.8rem;
    font-weight: 800;
  }
  .toc-panel a:global(.is-done) span {
    background: var(--good-fill);
    border-color: var(--good-fill);
    color: #fff;
  }
  .toc-panel a:global(.is-locked) {
    opacity: 0.55;
  }
  @media (max-width: 720px) {
    .bar-name,
    .toc-label {
      display: none;
    }
  }

  /* Lesson body */
  .lesson {
    max-width: 1000px;
    margin-inline: auto;
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding-bottom: 5rem;
  }
  .lesson-prose {
    max-width: none;
  }
  .lesson-prose :global(.lstep) {
    padding-bottom: 1rem;
  }
  .lesson-prose :global(.lstep + .lstep) {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 2px dashed var(--line);
  }
  .lesson-prose :global(.lstep.is-current) {
    animation: step-in 0.45s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  @keyframes step-in {
    from {
      opacity: 0;
    }
  }
  .lesson-prose :global(.lstep > *),
  .lesson-prose > :global(*) {
    max-width: 680px;
  }
  .lesson-prose :global(.lstep > * + *) {
    margin-top: 1.1em;
  }
  .lesson-prose :global(.lstep > h2) {
    margin-top: 0;
    scroll-margin-top: 150px;
  }
  .lesson-prose :global(.lstep > h2:focus) {
    outline: none;
  }
  .lesson-prose :global(.lstep > h2 + *),
  .lesson-prose :global(.lstep > h3 + *) {
    margin-top: 0.6em;
  }
  .lesson-prose :global(.lstep > figure),
  .lesson-prose :global(.lstep > .worked),
  .lesson-prose :global(.lstep > .table-scroll),
  .lesson-prose > :global(figure),
  .lesson-prose > :global(.worked),
  .lesson-prose > :global(.table-scroll) {
    max-width: none;
    margin-block: 2.2rem;
    clear: both;
  }
  .lesson-prose :global(.lstep-next) {
    clear: both;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem !important;
    padding: 1.6rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--bg-2);
    border: 2px solid var(--line);
    text-align: center;
    max-width: 680px;
  }
  .lesson-prose :global(.lstep-next .btn) {
    min-width: min(320px, 100%);
  }
  .lesson-prose :global(.lstep-next p) {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--ink-3);
  }
  .lesson-prose :global(.lstep:not(.is-current) .lstep-next),
  .mode-all .lesson-prose :global(.lstep-next) {
    display: none;
  }

  .unit-check {
    margin-top: 3.5rem;
  }
  .terms {
    padding: clamp(1.3rem, 1rem + 1vw, 2rem);
    border-radius: var(--radius-lg);
    border: 2px solid var(--line);
    background: var(--card);
  }
  .terms .eyebrow {
    margin-bottom: 0.4rem;
  }
  .terms dl {
    display: grid;
    margin: 1.3rem 0 1rem;
  }
  @media (min-width: 760px) {
    .terms dl {
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
    }
  }
  .term {
    padding: 0.8rem 0;
    border-bottom: 2px solid var(--line);
    scroll-margin-top: 150px;
  }
  .term:target {
    background: var(--sun-tint);
  }
  .term dt {
    font-weight: 800;
