---
import Base from '../layouts/Base.astro';
import GraphThumb from '../components/GraphThumb.astro';
import { url } from '../lib/url';
---
<Base title="Page not found" noindex>
  <section class="nf">
    <div class="wrap nf-grid">
      <div class="nf-copy">
        <p class="eyebrow">Error 404</p>
        <h1 class="page-title">This page is off the curve.</h1>
        <p class="lede">The link may be old, or the address may have a typo. Try one of these instead.</p>
        <div class="btn-row">
          <a class="btn btn-big" href={url('/learn/')}>See all units</a>
          <a class="btn btn-secondary btn-big" href={url('/')}>Go to the home page</a>
        </div>
      </div>
      <div class="nf-art card" aria-hidden="true">
        <GraphThumb model="ppc" state={{ x: 118, y: 96 }} width={380} height={300} />
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(3rem, 2rem + 6vw, 7rem);
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--brand) 16%, transparent) 1px, transparent 0) 0 0 / 22px 22px,
      linear-gradient(180deg, var(--brand-tint), var(--bg));
  }
  .nf-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .nf-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .nf-copy {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .nf-art {
    padding: 1.25rem;
    box-shadow: 0 5px 0 var(--line), var(--shadow-lg);
  }
</style>
