---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import { units } from '../data/units';
import { accountsOn, MAX_NAME, MIN_PASSWORD } from '../lib/accounts';
import { url } from '../lib/url';

const title = accountsOn ? 'Your account and data' : 'Your data and settings';
const lede = accountsOn
  ? 'Your progress is saved in this browser as you study. If you sign in, a copy is also kept in your account so you can use it on other devices. You can see, move, and delete all of it here.'
  : 'TutorEcon has no accounts switched on and no server that stores information about you. Everything below lives only in this browser, and you can download it, load it on another device, or delete it here.';
---
<Base title={title} description="Sign in or out, see and delete everything TutorEcon has saved, move your progress to another device, and change the theme.">
  <PageBand eyebrow="Your data" title={title} lede={lede} />

  <div class="wrap grid">
    <section class="panel card wide" aria-labelledby="acct-title" data-acct>
      <h2 id="acct-title" class="h3">Account</h2>
      {accountsOn ? (
        <>
          <p class="muted" data-acct-loading>Checking whether you are signed in.</p>

          <div data-acct-out hidden>
            <p>Sign in to keep your progress in an account and use it on any device. Anything you have done in this browser is added to the account when you sign in.</p>
            <div class="btn-row">
              <a class="btn btn-small" href={url('/sign-in/')}>Sign in</a>
              <a class="btn btn-secondary btn-small" href={url('/sign-up/')}>Create an account</a>
            </div>
          </div>

          <div data-acct-in hidden>
            <div class="profile">
              <span class="avatar avatar-lg" data-acct-avatar aria-hidden="true"></span>
              <div class="profile-text">
                <p class="p-name" data-acct-name></p>
                <p class="muted" data-acct-email></p>
                <p class="muted small" data-acct-since></p>
              </div>
            </div>
            <p class="sync-line" data-sync-line aria-live="polite"></p>
            <div class="btn-row">
              <a class="btn btn-small" href={url('/dashboard/')}>Open dashboard</a>
              <button type="button" class="btn btn-secondary btn-small" data-sync-now>Sync now</button>
              <button type="button" class="btn btn-secondary btn-small" data-toggle="name" aria-expanded="false" aria-controls="name-box">Edit name</button>
              <button type="button" class="btn btn-secondary btn-small" data-toggle="email" data-email-only aria-expanded="false" aria-controls="email-box">Change email</button>
              <button type="button" class="btn btn-secondary btn-small" data-toggle="pw" data-email-only aria-expanded="false" aria-controls="pw-box">Change password</button>
              <button type="button" class="btn btn-secondary btn-small" data-toggle="out" aria-expanded="false" aria-controls="out-box">Sign out</button>
              <button type="button" class="btn btn-secondary btn-small danger" data-toggle="del" aria-expanded="false" aria-controls="del-box">Delete account</button>
            </div>

            <form id="name-box" class="auth-form sub" novalidate data-box="name" hidden>
              <div class="field">
                <label for="acct-name">First name</label>
                <input id="acct-name" type="text" class="input" autocomplete="given-name" maxlength={MAX_NAME} aria-describedby="acct-name-hint" />
                <p id="acct-name-hint" class="hint">Used only to greet you. Leave it empty to remove it.</p>
              </div>
              <p class="error-text form-error" role="alert" data-error="form"></p>
              <div class="btn-row">
                <button type="submit" class="btn btn-small" data-name-save>Save name</button>
              </div>
            </form>

            <form id="email-box" class="auth-form sub" novalidate data-box="email" hidden>
              <div class="field">
                <label for="acct-email">New email address</label>
                <input id="acct-email" type="email" class="input" autocomplete="email" spellcheck="false" aria-describedby="acct-email-hint acct-email-error" aria-invalid="false" />
                <p id="acct-email-hint" class="hint">We send a link to the new address. Your email changes once you open it.</p>
                <p id="acct-email-error" class="error-text" data-error="email"></p>
              </div>
              <p class="error-text form-error" role="alert" data-error="form"></p>
              <div class="btn-row">
                <button type="submit" class="btn btn-small" data-email-save>Send confirmation link</button>
              </div>
            </form>

            <form id="pw-box" class="auth-form sub" novalidate data-box="pw" hidden>
              <div class="field">
                <label for="acct-password">New password</label>
                <div class="pw">
                  <input id="acct-password" type="password" class="input" autocomplete="new-password" minlength={MIN_PASSWORD} aria-describedby="acct-password-hint acct-password-error" aria-invalid="false" />
                  <button type="button" class="reveal" data-reveal aria-controls="acct-password" aria-pressed="false" aria-label="Show password">Show</button>
                </div>
                <div class="meter" data-meter="acct-password" data-score="0" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                <p class="meter-text" data-meter-text="acct-password" aria-live="polite"></p>
                <p id="acct-password-hint" class="hint">At least {MIN_PASSWORD} characters.</p>
                <p id="acct-password-error" class="error-text" data-error="password"></p>
              </div>
              <p class="error-text form-error" role="alert" data-error="form"></p>
              <div class="btn-row">
                <button type="submit" class="btn btn-small" data-pw-save>Save new password</button>
              </div>
            </form>

            <div id="out-box" class="sub confirm-soft" data-box="out" hidden>
              <p><strong>Sign out of this browser?</strong> Your progress stays in your account. On a shared computer, also clear it from this browser.</p>
              <div class="btn-row">
                <button type="button" class="btn btn-small" data-out-clear>Sign out and clear this browser</button>
                <button type="button" class="btn btn-secondary btn-small" data-out-keep>Sign out, keep my progress here</button>
              </div>
            </div>

            <div id="del-box" class="sub confirm" data-box="del" hidden>
              <p><strong>Delete your account?</strong> This erases your email address and the progress saved in your account. It cannot be undone. The progress in this browser stays unless you also delete it below.</p>
              <div class="btn-row">
                <button type="button" class="btn btn-small btn-bad" data-del-yes>Yes, delete my account</button>
                <button type="button" class="btn btn-secondary btn-small" data-toggle="del" aria-controls="del-box">Keep my account</button>
              </div>
            </div>
          </div>
          <p class="hint" data-acct-msg aria-live="polite"></p>
        </>
      ) : (
        <p>Accounts are not switched on for this copy of the site, so everything stays in this browser. To move your progress to another device, download it below and load the file on the other device.</p>
      )}
    </section>
    <section class="panel card" aria-labelledby="plan-title">
      <h2 id="plan-title" class="h3">Plan</h2>
      <div data-plan-free>
        <p><strong>Free.</strong> Every lesson, graph, and practice question is included.</p>
        <a class="btn btn-secondary btn-small" href={url('/pricing/')}>See what Pro adds</a>
      </div>
      <div data-plan-pro hidden>
        <p><strong>Pro (demo).</strong> Turned on <span data-pro-since></span>. No payment was taken.</p>
        <div class="btn-row">
          <button type="button" class="btn btn-secondary btn-small" data-cancel-pro>Cancel Pro</button>
        </div>
      </div>
      <p class="hint" data-plan-msg aria-live="polite"></p>
    </section>

    <section class="panel card" aria-labelledby="theme-title">
      <h2 id="theme-title" class="h3">Theme</h2>
      <fieldset class="ctl-choice">
        <legend class="visually-hidden">Color theme</legend>
        <div class="seg">
          <label><input type="radio" name="theme" value="system" /><span>Match my device</span></label>
          <label><input type="radio" name="theme" value="light" /><span>Light</span></label>
          <label><input type="radio" name="theme" value="dark" /><span>Dark</span></label>
        </div>
      </fieldset>
    </section>

    <section class="panel card wide" aria-labelledby="progress-title">
      <h2 id="progress-title" class="h3">Progress</h2>
      <p data-progress-summary></p>
      <div class="table-scroll">
        <table class="progress-table">
          <thead>
            <tr><th scope="col">Unit</th><th scope="col">Marked done</th><th scope="col">Best quiz score</th></tr>
          </thead>
          <tbody>
            {units.map((u) => (
              <tr data-row={u.slug}>
                <th scope="row"><a href={url(`/learn/${u.slug}/`)}>{u.title}</a></th>
                <td data-done>No</td>
                <td data-quiz>None yet</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel card wide" aria-labelledby="stored-title">
      <h2 id="stored-title" class="h3">Exactly what is stored</h2>
      <p>{accountsOn ? 'Up to five entries in this browser’s local storage, and nothing else. No cookies.' : 'Up to three entries in this browser’s local storage, and nothing else. No cookies.'} After some actions, a one-line notice waits in session storage (<span class="mono">tutorecon.toast</span>) until the next page shows it.</p>
      <dl class="stored">
        <div>
          <dt class="mono">tutorecon.v1</dt>
          <dd>Units you marked done, how far you read in each lesson, your best quiz scores, which questions you already got right, how many times you tried each question-bank question and whether your last try was right, questions you flagged to review, your free-response self-scores, which flashcards you marked as known, your study plan, your XP and streak, your last 20 mock exam scores, and whether the Pro demo is on.</dd>
        </div>
        <div>
          <dt class="mono">tutorecon.theme</dt>
          <dd>Your light or dark theme choice, if you made one.</dd>
        </div>
        <div>
          <dt class="mono">tutorecon.lessonMode</dt>
          <dd>Whether you read lessons one step at a time or all at once, if you changed it.</dd>
        </div>
        {accountsOn && (
          <>
            <div>
              <dt class="mono">tutorecon.auth</dt>
              <dd>Only while you are signed in: the sign-in tokens that keep you signed in. Removed when you sign out. Without “Keep me signed in”, they sit in session storage instead and go away when you close the tab.</dd>
            </div>
            <div>
              <dt class="mono">tutorecon.sync</dt>
              <dd>Only if you have signed in here: which account this browser last synced with, when, and whether it has changes not yet saved to the account.</dd>
            </div>
          </>
        )}
      </dl>
      {accountsOn && <p>When you are signed in, the <span class="mono">tutorecon.v1</span> entry is also saved to your account, along with your email address and the first name you gave, if any. Nothing else goes to the account service.</p>}
      <div class="btn-row">
        <button type="button" class="btn btn-secondary btn-small" data-download>Download my data</button>
        <label class="btn btn-secondary btn-small file-btn">
          <input type="file" accept=".json,application/json" class="visually-hidden" data-import />
          Load data from a file
        </label>
        <button type="button" class="btn btn-secondary btn-small danger" data-delete>Delete all my data</button>
      </div>
      <p class="hint">Loading a file adds its progress to what is already here. Nothing is lost from either side.</p>
      <p class="hint" data-import-msg aria-live="polite"></p>
      <div class="confirm" data-delete-confirm hidden>
        <p><strong>Delete everything?</strong> <span data-delete-text>Your progress, scores, theme, and Pro demo status will be removed from this browser. This cannot be undone.</span></p>
        <div class="btn-row">
          <button type="button" class="btn btn-small btn-bad" data-delete-yes>Yes, delete my data</button>
          <button type="button" class="btn btn-secondary btn-small" data-delete-no>Keep my data</button>
        </div>
      </div>
      <p class="hint" data-delete-msg aria-live="polite"></p>
    </section>
  </div>
</Base>

<script>
  import { store, currentTheme } from '../scripts/store';
  import { cleanSaved, mergeSaved } from '../scripts/merge';
  import {
    accountsOn,
    authMessage,
    connect,
    currentSession,
    deleteAccount,
    displayName,
    initials,
    onAuth,
    provider,
    saveName,
    signOut,
    siteLink,
    syncNow,
    syncState,
  } from '../scripts/account';
  import { MIN_PASSWORD } from '../lib/accounts';
  import { busy, emailOk, fieldError, wireMeter, wireReveal } from '../scripts/forms';
  import { toast } from '../scripts/toast';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;

  const render = () => {
    const data = store.get();
    $('[data-plan-free]').hidden = Boolean(data.pro);
    $('[data-plan-pro]').hidden = !data.pro;
    if (data.pro) $('[data-pro-since]').textContent = `on ${new Date(data.pro.since).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}`;

    let done = 0;
    document.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
      const slug = row.dataset.row!;
      const isDone = Boolean(data.done[slug]);
      if (isDone) done++;
      row.querySelector('[data-done]')!.textContent = isDone ? 'Yes' : 'No';
      const q = data.quiz[slug];
      row.querySelector('[data-quiz]')!.textContent = q ? `${q.best} of ${q.total}` : 'None yet';
    });
    const exams = data.exams.length;
    const streak = store.currentStreak();
    $('[data-progress-summary]').textContent = `${done} of ${document.querySelectorAll('[data-row]').length} units marked done. ${data.xp} XP earned. ${streak ? `${streak} day streak.` : 'No streak running.'} ${exams ? `${exams} mock exam${exams === 1 ? '' : 's'} taken.` : 'No mock exams taken yet.'}`;

    const saved = store.getTheme();
    const value = saved ?? 'system';
    document.querySelectorAll<HTMLInputElement>('input[name="theme"]').forEach((r) => (r.checked = r.value === value));
  };

  document.querySelectorAll<HTMLInputElement>('input[name="theme"]').forEach((r) =>
    r.addEventListener('change', () => {
      if (r.value === 'system') {
        try {
          localStorage.removeItem('tutorecon.theme');
        } catch {
          /* nothing stored */
        }
        delete document.documentElement.dataset.theme;
      } else store.setTheme(r.value as 'light' | 'dark');
      window.dispatchEvent(new CustomEvent('tutorecon:theme'));
      document.querySelector('[data-theme-toggle]')?.setAttribute('data-current', currentTheme());
    }),
  );

  $('[data-cancel-pro]').addEventListener('click', () => {
    store.cancelPro();
    $('[data-plan-msg]').textContent = 'Pro is off. Your progress and scores are still here.';
    render();
  });

  $('[data-download]').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify({ 'tutorecon.v1': store.get(), 'tutorecon.theme': store.getTheme(), 'tutorecon.lessonMode': store.getLessonMode() }, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'tutorecon-data.json';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });

  // Load a downloaded file on this device. Its progress is added, not swapped in.
  const importInput = $<HTMLInputElement>('[data-import]');
  importInput.addEventListener('change', async () => {
    const file = importInput.files?.[0];
    const msg = $('[data-import-msg]');
    if (!file) return;
    try {
      const raw = JSON.parse(await file.text());
      const body = raw && typeof raw === 'object' && 'tutorecon.v1' in raw ? raw['tutorecon.v1'] : raw;
      const known = ['done', 'quiz', 'xp', 'qstats', 'steps', 'cards', 'frq'];
      if (!body || typeof body !== 'object' || !known.some((k) => k in body)) throw new Error('not ours');
      store.replace(mergeSaved(store.get(), cleanSaved(body)));
      msg.textContent = `Loaded ${file.name}. Its progress has been added to this browser.`;
    } catch {
      msg.textContent = 'That file is not a TutorEcon data file. Use the file made by “Download my data”.';
    }
    importInput.value = '';
  });

  const confirmBox = $('[data-delete-confirm]');
  $('[data-delete]').addEventListener('click', () => {
    $('[data-delete-text]').textContent = currentSession()
      ? 'This signs you out and removes your progress, scores, theme, and Pro demo status from this browser. The copy in your account stays until you delete the account above.'
      : 'Your progress, scores, theme, and Pro demo status will be removed from this browser. This cannot be undone.';
    confirmBox.hidden = false;
    $<HTMLButtonElement>('[data-delete-no]').focus();
  });
  $('[data-delete-no]').addEventListener('click', () => {
    confirmBox.hidden = true;
    $<HTMLButtonElement>('[data-delete]').focus();
  });
  $('[data-delete-yes]').addEventListener('click', async () => {
    if (currentSession()) await signOut(true).catch(() => undefined);
    store.clearAll();
    confirmBox.hidden = true;
    $('[data-delete-msg]').textContent = 'Deleted. This browser no longer holds any TutorEcon data.';
    render();
    $<HTMLButtonElement>('[data-delete]').focus();
  });

  window.addEventListener('tutorecon:change', render);
  render();

  // Account controls, only when the site has accounts switched on.
  const acct = document.querySelector<HTMLElement>('[data-acct]');
  if (accountsOn && acct) {
    const q = <T extends HTMLElement = HTMLElement>(sel: string) => acct.querySelector<T>(sel)!;
    const say = (text: string) => (q('[data-acct-msg]').textContent = text);
    wireReveal(acct);

    const ago = (iso: string) => {
      const mins = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
      if (mins < 1) return 'just now';
      if (mins < 60) return `${mins} minute${mins === 1 ? '' : 's'} ago`;
      return new Date(iso).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    };
    const showSync = () => {
      const st = syncState();
      const line = q('[data-sync-line]');
      if (st.state === 'saving') line.textContent = 'Saving to your account.';
      else if (st.state === 'error') line.textContent = 'Could not reach your account just now. Your progress is safe in this browser and will be saved to the account next time.';
      else line.textContent = st.at ? `Progress saved to your account ${ago(st.at)}.` : 'Progress will be saved to your account as you study.';
    };
    window.addEventListener('tutorecon:sync', showSync);

    const boxes = ['name', 'email', 'pw', 'out', 'del'];
    const openBox = (name: string | null) => {
      for (const b of boxes) {
        const open = b === name;
        q(`[data-box="${b}"]`).hidden = !open;
        acct.querySelectorAll(`[data-toggle="${b}"]`).forEach((t) => t.setAttribute('aria-expanded', String(open)));
      }
    };
    acct.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const name = btn.dataset.toggle!;
        const wasOpen = !q(`[data-box="${name}"]`).hidden;
        openBox(wasOpen ? null : name);
        if (!wasOpen) q(`[data-box="${name}"]`).querySelector<HTMLElement>('input, button')?.focus();
      }),
    );

    onAuth((s) => {
      q('[data-acct-loading]').hidden = true;
      q('[data-acct-out]').hidden = Boolean(s);
      q('[data-acct-in]').hidden = !s;
      if (s) {
        const u = s.user;
        const name = displayName(u);
        q('[data-acct-avatar]').textContent = initials(u);
        q('[data-acct-name]').textContent = name || 'No name added';
        q('[data-acct-name]').classList.toggle('muted', !name);
        q('[data-acct-email]').textContent = u.email ?? '';
        const since = u.created_at ? new Date(u.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) : '';
        const via = provider(u) === 'google' ? 'Signs in with Google.' : 'Signs in with email and password.';
        q('[data-acct-since]').textContent = `${since ? `Member since ${since}. ` : ''}${via}`;
        acct.querySelectorAll<HTMLElement>('[data-email-only]').forEach((el) => (el.hidden = provider(u) === 'google'));
        q<HTMLInputElement>('#acct-name').value = name;
      } else openBox(null);
      showSync();
    });

    q('[data-sync-now]').addEventListener('click', async () => {
      say('');
      await syncNow();
      if (syncState().state === 'saved') say('Up to date. This browser and your account now match.');
    });

    const nameForm = q<HTMLFormElement>('[data-box="name"]');
    const nameSave = q<HTMLButtonElement>('[data-name-save]');
    nameForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      fieldError(nameForm, 'form', '');
      const value = q<HTMLInputElement>('#acct-name').value.trim().replace(/\s+/g, ' ').slice(0, 40);
      busy(nameSave, true, 'Saving');
      try {
        await saveName(value);
        const u = currentSession()?.user;
        q('[data-acct-name]').textContent = displayName(u) || 'No name added';
        q('[data-acct-name]').classList.toggle('muted', !displayName(u));
        q('[data-acct-avatar]').textContent = initials(u);
        openBox(null);
        toast(value ? 'Name saved.' : 'Name removed.');
      } catch (err) {
        fieldError(nameForm, 'form', authMessage(err));
      } finally {
        busy(nameSave, false, 'Save name');
      }
    });

    const emailForm = q<HTMLFormElement>('[data-box="email"]');
    const newEmail = q<HTMLInputElement>('#acct-email');
    const emailSave = q<HTMLButtonElement>('[data-email-save]');
    emailForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      fieldError(emailForm, 'form', '');
      const e = newEmail.value.trim();
      const msg = !e ? 'Enter the new email address.' : !emailOk(e) ? 'Enter an email address like name@example.com.' : e.toLowerCase() === (currentSession()?.user.email ?? '').toLowerCase() ? 'That is already your email address.' : '';
      fieldError(emailForm, 'email', msg, newEmail);
      if (msg) return newEmail.focus();
      busy(emailSave, true, 'Sending');
      try {
        const client = await connect();
        const { error } = await client.auth.updateUser({ email: e }, { emailRedirectTo: siteLink('/account/') });
        if (error) throw error;
        newEmail.value = '';
        openBox(null);
        say(`Check ${e} for a confirmation link. Your email changes once you open it. For extra safety, you may also get a link at your current address, and both need to be opened.`);
      } catch (err) {
        fieldError(emailForm, 'form', authMessage(err));
      } finally {
        busy(emailSave, false, 'Send confirmation link');
      }
    });

    const pwForm = q<HTMLFormElement>('[data-box="pw"]');
    const pw = q<HTMLInputElement>('#acct-password');
    const pwMeter = wireMeter(pw, null, MIN_PASSWORD);
    const pwSave = q<HTMLButtonElement>('[data-pw-save]');
    pwForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      fieldError(pwForm, 'form', '');
      const msg = pwMeter().problem;
      fieldError(pwForm, 'password', msg, pw);
      if (msg) return pw.focus();
      busy(pwSave, true, 'Saving');
      try {
        const client = await connect();
        const { error } = await client.auth.updateUser({ password: pw.value });
        if (error) throw error;
        pw.value = '';
        pwMeter();
        openBox(null);
        toast('Password changed.');
      } catch (err) {
        fieldError(pwForm, 'form', authMessage(err));
      } finally {
        busy(pwSave, false, 'Save new password');
      }
    });

    const out = async (clearHere: boolean) => {
      say('Signing out.');
      try {
        await signOut(clearHere);
        say(clearHere ? 'Signed out. Your progress was cleared from this browser and is still in your account.' : 'Signed out. Your progress is still here and in your account.');
        q<HTMLAnchorElement>('[data-acct-out] a').focus();
      } catch (err) {
        say(authMessage(err));
      }
    };
    q('[data-out-clear]').addEventListener('click', () => out(true));
    q('[data-out-keep]').addEventListener('click', () => out(false));

    q('[data-del-yes]').addEventListener('click', async () => {
      const btn = q<HTMLButtonElement>('[data-del-yes]');
      busy(btn, true, 'Deleting');
      try {
        await deleteAccount();
        say('Your account and the progress saved in it are deleted. The progress in this browser is still here.');
        q<HTMLAnchorElement>('[data-acct-out] a').focus();
      } catch (err) {
        say(authMessage(err));
      } finally {
        busy(btn, false, 'Yes, delete my account');
      }
    });
  }
</script>

